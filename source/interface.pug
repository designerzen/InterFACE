		li: a(href="#help" aria-label="Show some helpful information" onclick="window.help.showModal()") Help!

block preload
	script document.documentElement.classList.add("loading","app")
	link(rel="preload" href="index.js" as="script") 

block scripts
	script(type="module" src="accessibility/start-accessibility.js")
	script(type="module" src="dom/start-background.js")
	script(type="module" src="index.js")
	script(type="module").
		const plasmaBtn = document.querySelector('#picade-plasma-test-btn')
		const plasmaStatus = document.querySelector('#picade-plasma-status')
		const plasmaConfigBtn = document.querySelector('#picade-plasma-config-btn')
		if (plasmaBtn) {
			plasmaBtn.addEventListener('click', async () => {
				plasmaBtn.disabled = true
				try {
					const { testPicadePlasmaLights } = await import('./hardware/gamepad/picade-plasma-test.js')
					plasmaBtn.disabled = false
					await testPicadePlasmaLights(plasmaBtn, plasmaStatus)
				} catch (error) {
					plasmaStatus.textContent = 'PhotoSYNTH could not load Picade Plasma support. Please try again.'
					plasmaStatus.dataset.state = 'error'
					plasmaBtn.disabled = false
					console.warn('Unable to load Picade Plasma light support', error)
				}
			})
		}
		if (plasmaConfigBtn) {
			plasmaConfigBtn.addEventListener('click', async event => {
				event.preventDefault()
				const { getPicadeConfiguratorUrl } = await import('./hardware/gamepad/picade-config-navigation.js')
				window.location.href = getPicadeConfiguratorUrl(window.location.href, plasmaConfigBtn.href)
			})
		}

