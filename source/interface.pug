block above 
	#load-progress
		label(for="progress-bar") Please wait <br>loading may take a long time
			span.load-percent 0%
		progress(max=1 role="progressbar" aria-describedby="app" title="Load progress" value=0 )#progress-bar.donut
		
block nav
	ul
		li: a#link-about(href="#fund" aria-label="Learn more about this project" onclick="window.fund.showModal()") About<span class="hide-text"> this project and how to help fund it<span>
		li: a(href="#help" aria-label="Show some helpful information" onclick="window.help.showModal()") Help!

block preload
	script document.documentElement.classList.add("loading","app")
	link(rel="preload" href="index.js" as="script") 

block scripts
	script(type="module" src="accessibility/start-accessibility.js")
	script(type="module" src="dom/start-background.js")
	script(type="module" src="index.js")
	script(type="module").
		const plasmaBtn = document.querySelector('#picade-plasma-test-btn')
		const plasmaStatus = document.querySelector('#picade-plasma-status')
		const plasmaConfigBtn = document.querySelector('#picade-plasma-config-btn')
		if (plasmaBtn) {
			plasmaBtn.addEventListener('click', async () => {
				plasmaBtn.disabled = true
				try {
					const { testPicadePlasmaLights } = await import('./hardware/gamepad/picade-plasma-test.js')
					plasmaBtn.disabled = false
					await testPicadePlasmaLights(plasmaBtn, plasmaStatus)
				} catch (error) {
					plasmaStatus.textContent = 'PhotoSYNTH could not load Picade Plasma support. Please try again.'
					plasmaStatus.dataset.state = 'error'
					plasmaBtn.disabled = false
					console.warn('Unable to load Picade Plasma light support', error)
				}
			})
		}
		if (plasmaConfigBtn) {
			plasmaConfigBtn.addEventListener('click', async event => {
				event.preventDefault()
				const { getPicadeConfiguratorUrl } = await import('./hardware/gamepad/picade-config-navigation.js')
				window.location.href = getPicadeConfiguratorUrl(window.location.href, plasmaConfigBtn.href)
			})
		}

block main

	//- Accessibility options
	include partials/a11y.pug
		
	main#app(aria-describedby="progress-bar")
		
		h3(screenreader-only)#title Emotionally Controlled Synthesizer
		h4(screenreader-only)#subtitle Use your moods to make music.

		p(role="status" aria-live="polite" popover="manual")#feedback
		include partials/toast.pug		

		a(href="/")#share-code
			// logo OR QR code
			.qr 
				img(src="/source/assets/qr/interface.place-red.png" alt="QR code linking to the PhotoSYNTH website")
			
			p Share this app with friends

		#app-frame

			//- Pick how many people etc
			include partials/onboarding.pug

			#stage
				//- THE video element fed by video camera			
				video#webcam(autoplay, playsinline, loop, muted="muted", oncanplay="this.muted=true", width="640", height="480")
					p No Video available - unable to playback emoji

				//- we clone the video onto the canvas every frame - this has a JS helper
				//- that deletes this node and re-creates it with a different context
				canvas#photosynth-canvas.canvas-full-size(width="640", height="480")
				canvas#photosynth-sandwich.canvas-full-size(width="640", height="480")
				canvas#photosynth-overlay.canvas-full-size(width="640", height="480")
				
	
			//- control panel with multi-levels
			include partials/control-panel.pug

			//- HUD : contains the input types + data
			aside#input-status-overlay(hidden aria-live="polite" aria-label="Connected input devices")
				ul#input-status-list
			
			//- MIDI FILE Uploader
			form#upload-midi-form
				label(for="midi-upload-input") Upload a MIDI backing track!
				input#midi-upload-input(type="file" hidden name="midi-upload")
				button#button-midi-upload( type="button" ) Upload MIDI file
			

		//-  For users with javascript disabled 
		noscript
			p.
				This application requires javascript to work unfortunately and doesn't do much without it. 
				You can install 
				
	section#contact
		h4 Contact 
		p Questions, ideas or feedback? 
		a.contact-email(href="mailto:radio@awesomething.co.uk") Get in touch (email radio@awesomething.co.uk)
		| or 
		label(for="mce-EMAIL").link-secret join the newsletter 
		| for project news and future events.

		include partials/newsletter.pug

	section#integration.connections.mixed-content
		h3 Use with other musical devices & software.
		p The PhotoSYNTH can control, and be controlled, by your outboard MIDI gear as well as any DAW and MIDI software. Some common setups are outlined below.
	
		details#integration-software.accordion
			summary
				h4 Software Integration
				p You can control your DAW or record the output audio or MIDI.
				
			.details 
				p
				
			details(name="software")#ableton
				summary.with-image
					img.hardware-summary-photo(src="./assets/hardware/cosmo-dot.jpg" width="1000" height="800" loading="lazy" decoding="async" alt="" aria-hidden="true")
					span.hardware-summary-name Ableton
				.details
					h4: a(href="https://www.ableton.com/" rel="noopener noreferrer" target="_blank") Ableton
					p Ableton Live can be used to record both the audio and the note commands (MIDI) from the software. For this to work, a virtual MIDI port needs to be created!
			
			details(name="software")#opendaw
				summary.with-image
					img.hardware-summary-photo(src="./assets/hardware/cosmo-dot.jpg" width="1000" height="800" loading="lazy" decoding="async" alt="" aria-hidden="true")
					span.hardware-summary-name OpenDAW
				.details
					h4: a(href="https://opendaw.studio/" rel="noopener noreferrer" target="_blank") OpenDAW
					p OpenDAW is a free, open source audio workstation that integrates with the PhotoSYNTH!
					
		details#integration-hardware.accordion
			summary
				h4 Hardware : Use External Gear
				p Synchronise with your external gear, musical devices and hardware.
				
			.details
				p All MIDI devices work natively both as controllers and as receivers of MIDI data. 
				p Certain external hardware works directly and is supported, with the following devices adding new functionality and interactivity.
		
				details(name="hardware")#gamepads
					summary.with-image
						img.hardware-summary-photo(src="./assets/icons/gamepad_black_24dp.svg" width="24" height="24" loading="lazy" decoding="async" alt="" aria-hidden="true")
						span.hardware-summary-name Gamepads
					.details
						h4 Gamepads
						p Use a compatible gamepad to play beats, instruments and chords, control visual effects, and adjust performance controls.
						p Connect your controller to your computer or device, then press a button while PhotoSYNTH is open so it can detect the gamepad.

				details(name="hardware")#qwerty-keyboards
					summary.with-image
						img.hardware-summary-photo(src="./assets/icons/keyboard.svg" width="24" height="24" loading="lazy" decoding="async" alt="" aria-hidden="true")
						span.hardware-summary-name QWERTY Keyboards
					.details
						h4 QWERTY Keyboards
						p Turn your computer keyboard into a musical controller to play notes, chords, percussion and samples, or use operational shortcuts to control PhotoSYNTH.
						p Choose a Keyboard Mode in the controls, or use F1–F6 to switch between Operational, Notes, Notes +1 Octave, Chords, Percussion and Samples. Page Up and Page Down also change keyboard mode.

				details(name="hardware")#stream-deck
					summary.with-image
						img.hardware-summary-photo(src="./assets/hardware/stream-deck-xl.jpg" width="2814" height="1984" loading="lazy" decoding="async" alt="" aria-hidden="true")
						span.hardware-summary-name Stream Deck (& XL)
					.details
						h4
							a(href="https://www.elgato.com/us/en/p/stream-deck-xl" rel="noopener noreferrer" target="_blank") Stream Deck
							|  profiles
						p Turn your Stream Deck into a PhotoSYNTH control surface for control instruments, visuals, drums and samples. Dedicated pages switch between note, chord, percussion and sample performance modes.
						p Install the profile for your key layout to make PhotoSYNTH quicker to learn and easier to perform live, without memorising keyboard shortcuts.
						a.button.button-push.button-download.text-always(
							href="../static/PhotoSYNTH.streamDeckProfile"
							download="PhotoSYNTH.streamDeckProfile"
						) Download XL profile — 32 keys
						a.button.button-push.button-download.text-always(
							href="../static/PhotoSYNTH-Stream-Deck.streamDeckProfile"
							download="PhotoSYNTH-Stream-Deck.streamDeckProfile"
						) Download standard profile — 15 keys
		
				details(name="hardware")#cosmo-dots
					summary
						img.hardware-summary-photo(src="./assets/hardware/cosmo-dot.jpg" width="1000" height="800" loading="lazy" decoding="async" alt="" aria-hidden="true")
						span.hardware-summary-name Cosmo Dots
					.details
						h4: a(href="https://www.explorecosmo.com/cosmo-dot/" rel="noopener noreferrer" target="_blank") Cosmo Dots
						p Use your Cosmo Dots with the PhotoSYNTH to trigger notes, chords and samples!
						p Set up each Dot so that it sends a unique number from 1–9. In musical keyboard mode, the number keys play natural notes without the black piano keys.
						figure.cosmo-note-guide
							ol.cosmo-note-dots(aria-label="Cosmo Dot number, pitch, and color guide")
								li.cosmo-note-dot(style="--note-hue: 353; --note-saturation: 78%; --note-lightness: 54%" title="C")
									span.cosmo-note-number 1
									span.cosmo-note-name C
								li.cosmo-note-dot(style="--note-hue: 20; --note-saturation: 81%; --note-lightness: 62%" title="D")
									span.cosmo-note-number 2
									span.cosmo-note-name D
								li.cosmo-note-dot(style="--note-hue: 54; --note-saturation: 83%; --note-lightness: 68%" title="E")
									span.cosmo-note-number 3
									span.cosmo-note-name E
								li.cosmo-note-dot(style="--note-hue: 69; --note-saturation: 54%; --note-lightness: 65%" title="F")
									span.cosmo-note-number 4
									span.cosmo-note-name F
								li.cosmo-note-dot(style="--note-hue: 177; --note-saturation: 67%; --note-lightness: 41%" title="G")
									span.cosmo-note-number 5
									span.cosmo-note-name G
								li.cosmo-note-dot(style="--note-hue: 256; --note-saturation: 39%; --note-lightness: 46%" title="A")
									span.cosmo-note-number 6
									span.cosmo-note-name A
								li.cosmo-note-dot(style="--note-hue: 325; --note-saturation: 90%; --note-lightness: 65%" title="B")
									span.cosmo-note-number 7
									span.cosmo-note-name B
								li.cosmo-note-dot(style="--note-hue: 353; --note-saturation: 78%; --note-lightness: 54%" title="C")
									span.cosmo-note-number 8
									span.cosmo-note-name C
								li.cosmo-note-dot(style="--note-hue: 20; --note-saturation: 81%; --note-lightness: 62%" title="D")
									span.cosmo-note-number 9
									span.cosmo-note-name D
							figcaption Numbers 1–8 play the complete C3–C4 octave; number 9 continues to D4. The pitch names also identify the colors without relying on color alone.
		
				details(name="hardware")#picade-plasma-lights
					summary.with-image
						img.hardware-summary-photo(src="./assets/hardware/picade-max-controller.jpg" width="480" height="480" loading="lazy" decoding="async" alt="" aria-hidden="true")
						span.hardware-summary-name Picade Max Input Plasma Lights
					.details
						h4: a(href="https://shop.pimoroni.com/products/picade-max-usb-controller" rel="noopener noreferrer" target="_blank") Picade Max USB Controller
						p Connect your Picade Max controller to test the Plasma button lights, or configure their physical order without connecting.
						p#picade-plasma-status.picade-plasma-feedback(role="status" aria-live="polite") Connect your Picade-Max Input controller with Plasma lights then use the configurator to set the button / light layout.
						.picade-plasma-actions
							button#picade-plasma-test-btn.button-push.text-always(type="button") Connect & Test Lights
							a#picade-plasma-config-btn.picade-plasma-config-link(href="./test.picade-plasma.pug")
								img(src="./assets/icons/build.svg" alt="" aria-hidden="true")
								| Configure Plasma Lights
	
