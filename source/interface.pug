block preload
	script document.documentElement.classList.add("loading","app")
	link(rel="preload" href="index.js" as="script") 

block scripts
	script(type="module" src="index.js")
	script(type="module").
		import { PicadePlasma } from './hardware/gamepad/picade-plasma.js'
		const PICADE_RAINBOW = [
			'#ff0000', '#ff8800', '#ffff00', '#88ff00',
			'#00ff00', '#00ff88', '#00ffff', '#0088ff',
			'#0000ff', '#8800ff', '#ff00ff', '#ff0088',
			'#ffffff', '#ff6666', '#66ff66', '#6666ff',
		]
		const plasmaBtn = document.querySelector('#picade-plasma-test-btn')
		const plasmaStatus = document.querySelector('#picade-plasma-status')
		if (plasmaBtn) {
			let plasma = null
			let flashTimer = null
			plasmaBtn.addEventListener('click', async () => {
				if (plasma?.connected) {
					clearTimeout(flashTimer)
					await plasma.clear()
					plasmaStatus.textContent = 'Lights cleared.'
					plasmaBtn.textContent = 'Connect & Test Lights'
					return
				}
				if (!('serial' in navigator)) {
					plasmaStatus.textContent = 'WebSerial is unavailable. Use Chrome, Edge, or the Electron app.'
					return
				}
				plasmaBtn.disabled = true
				plasmaBtn.textContent = 'Connecting…'
				plasmaStatus.textContent = 'Choose the Picade Plasma serial device…'
				try {
					plasma = new PicadePlasma({ buttonCount: 16, playerCount: 2 })
					await plasma.connect()
					plasmaBtn.disabled = false
					plasmaBtn.textContent = 'Clear Lights'
					plasmaStatus.textContent = 'Connected! Flashing lights in order…'
					await flashSequence()
				} catch (error) {
					plasmaStatus.textContent = `Connection failed: ${error.message}`
					plasmaBtn.disabled = false
					plasmaBtn.textContent = 'Connect & Test Lights'
				}
			})
			async function flashSequence() {
				const count = plasma.buttonCount
				for (let i = 0; i < count; i++) {
					const color = PICADE_RAINBOW[i % PICADE_RAINBOW.length]
					plasma.light(i, color)
					await new Promise(resolve => { flashTimer = setTimeout(resolve, 180) })
				}
				await new Promise(resolve => { flashTimer = setTimeout(resolve, 600) })
				for (let i = count - 1; i >= 0; i--) {
					const color = PICADE_RAINBOW[i % PICADE_RAINBOW.length]
					plasma.light(i, null)
					await new Promise(resolve => { flashTimer = setTimeout(resolve, 80) })
				}
				plasmaStatus.textContent = `Flashed ${count} lights in order. Press again to replay.`
			}
		}

block main

	//- Accessibility options
	include partials/a11y.pug
		
	main#app(aria-describedby="progress-bar")
		
		h3(screenreader-only)#title Emotionally Controlled Synthesizer
		h4(screenreader-only)#subtitle Use your moods to make music.

		p(role="status" aria-live="polite" popover="manual")#feedback Loading please wait!
		include partials/toast.pug		

		a(href="/")#share-code
			// logo OR QR code
			.qr 
				img(src="/source/assets/qr/interface.place-red.png" alt="QR code linking to the PhotoSYNTH website")
			
			p Share this app with friends

		#app-frame

			//- Pick how many people etc
			include partials/onboarding.pug

			#stage
				//- THE video element fed by video camera			
				video#webcam(autoplay, playsinline, loop, muted="muted", oncanplay="this.muted=true", width="640", height="480")
					p No Video available - unable to playback emoji

				//- we clone the video onto the canvas every frame - this has a JS helper
				//- that deletes this node and re-creates it with a different context
				canvas#photosynth-canvas.canvas-full-size(width="640", height="480")
				canvas#photosynth-sandwich.canvas-full-size(width="640", height="480")
				canvas#photosynth-overlay.canvas-full-size(width="640", height="480")
				
	
			//- control panel with multi-levels
			include partials/control-panel.pug

			//- HUD : contains the input types + data
			aside#input-status-overlay(hidden aria-live="polite" aria-label="Connected input devices")
				ul#input-status-list
			
			//- MIDI FILE Uploader
			form#upload-midi-form
				label(for="midi-upload-input") Upload a MIDI backing track!
				input#midi-upload-input(type="file" hidden name="midi-upload")
				button#button-midi-upload( type="button" ) Upload MIDI file
			

		//-  For users with javascript disabled 
		noscript
			p.
				This application requires javascript to work unfortunately and doesn't do much without it. 
				You can install 
				
	section#contact
		h4 Contact 
		p Questions, ideas or feedback? 
		a.contact-email(href="mailto:radio@awesomething.co.uk") Get in touch (email radio@awesomething.co.uk)
		| or 
		label(for="mce-EMAIL").link-secret join the newsletter 
		| for project news and future events.

		include partials/newsletter.pug

	section#hardware-integration.connections.mixed-content(aria-labelledby="hardware-integration-title")
		h3 Hardware Integration
		
		details(name="hardware")#stream-deck
			summary Stream Deck (& XL)

			h4 Stream Deck profiles
			p Turn your Stream Deck into a PhotoSYNTH control surface for control instruments, visuals, drums and samples. Dedicated pages switch between note, chord, percussion and sample performance modes.
			p Install the profile for your key layout to make PhotoSYNTH quicker to learn and easier to perform live, without memorising keyboard shortcuts.
			a.button.button-push.button-download.text-always(
				href="../static/PhotoSYNTH.streamDeckProfile"
				download="PhotoSYNTH.streamDeckProfile"
			) Download XL profile — 32 keys
			a.button.button-push.button-download.text-always(
				href="../static/PhotoSYNTH-Stream-Deck.streamDeckProfile"
				download="PhotoSYNTH-Stream-Deck.streamDeckProfile"
			) Download standard profile — 15 keys

		details(name="hardware")#cosmo-dots
			summary Cosmo Dots

			h4 Cosmo Dots 
			p Use your Cosmo Dots with the PhotoSYNTH to trigger notes, chords and samples!
			p Set up each Dot so that it sends out a unique numerical number from 0-9.

		details(name="hardware")#picade-plasma-lights
			summary Picade Max Input Plasma Lights
			p Connect your Picade Max controller to test the plasma button lights and see their order.
			p#picade-plasma-status(role="status" aria-live="polite") Press the button below to connect and flash the lights.
			button#picade-plasma-test-btn(type="button") Connect & Test Lights


