extends _base.pug

block title
	+title('Offline')

block nav

block preload 

block main
	main#offline
		section.mixed-content(role="status" aria-live="polite")
			h3 You appear to be offline
			p PhotoSYNTH needs an internet connection to load pages that have not been cached on this device yet.
			p Once you are back online, reload this page or return to the instrument.
			p
				a.button.button-push.text-always(href="./index.pug") Return to PhotoSYNTH
				|  
				button.button.button-push.text-always(type="button" onclick="window.location.reload()") Try again