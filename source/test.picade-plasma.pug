block scripts
	script(type="module").
		import { getPicadeMaxGamepadInfo } from './hardware/gamepad/picade-max-interface.js'
		import {
			createPicadeMaxController,
			findPicadeMaxInputGamepads,
			PICADE_RAPID_TAP_COLORS,
			PICADE_MAX_JOYSTICK_LEFT,
			PICADE_MAX_JOYSTICK_RIGHT,
			PICADE_MAX_JOYSTICK_UP,
			PICADE_MAX_JOYSTICK_DOWN,
		} from './hardware/gamepad/picade-max-input-controller.js'
		import { DIRECTION_DOWN, DIRECTION_LEFT, DIRECTION_RIGHT, DIRECTION_UP } from './hardware/gamepad/gamepad-commands.js'
		import {
			getPicadePlasmaLightPreset,
			parsePicadePlasmaLightLayout,
			PicadePlasma,
			PICADE_LONG_PRESS_COLOR,
			PICADE_PLASMA_BUTTON_EVENTS,
			PICADE_SHORT_PRESS_COLOR,
		} from './hardware/gamepad/picade-plasma.js'

		const LONG_PRESS_MS = 500
		const FADE_MS = 450
		const MAPPING_PREVIEW_COLOR = '#ffe600'
		const RAPID_TAP_WINDOW_MS = 500
		let controller = null
		let controllerKey = null
		let plasma = null
		const buttonGrid = document.querySelector('#button-grid')
		const lightButtonSelect = document.querySelector('#light-button')
		let buttons = []
		const status = document.querySelector('#connection-status')
		const gamepadStatus = document.querySelector('#gamepad-status')
		const plasmaSerialStatus = document.querySelector('#plasma-serial-status')
		const connect = document.querySelector('#connect')
		const demoToggle = document.querySelector('#demo-toggle')
		const lightControls = document.querySelector('#light-controls')
		const plasmaCommandList = document.querySelector('#plasma-command-list')
		let plasmaCommandCount = 0
		let plasmaAutoConnecting = false
		let plasmaConnectionError = null
		const inventoryStatus = document.querySelector('#gamepad-inventory-status')
		const gamepadList = document.querySelector('#gamepad-list')
		const mappingOutput = document.querySelector('#light-mapping-output')
		const mappingSelection = document.querySelector('#mapping-selection')
		const mappingSlots = document.querySelector('#light-mapping-slots')
		const copyLightMapping = document.querySelector('#copy-light-mapping')
		const clearLightMapping = document.querySelector('#clear-light-mapping')
		const picadeInputHud = document.querySelector('#picade-input-hud')
		const machineLightCount = document.querySelector('#machine-light-count')
		const PICADE_MAPPING_STORAGE_KEY = 'photosynth.picade-plasma.mapping.v1'
		const query = new URLSearchParams(window.location.search)
		const requestedLightPreset = query.get('lights')
		function loadSavedMapping() {
			try {
				const saved = JSON.parse(window.localStorage.getItem(PICADE_MAPPING_STORAGE_KEY) ?? 'null')
				if (typeof saved?.mapping !== 'string') return null
				const layout = parsePicadePlasmaLightLayout(saved.mapping)
				if (!layout) return null
				return {
					layout,
					physicalLightCount: Number.isInteger(saved.physicalLightCount) && saved.physicalLightCount >= layout.buttonCount
						? saved.physicalLightCount
						: layout.buttonCount,
				}
			} catch {
				return null
			}
		}
		const savedMapping = requestedLightPreset == null ? loadSavedMapping() : null
		const requestedLightLayout = getPicadePlasmaLightPreset(requestedLightPreset)
		const initialLightLayout = savedMapping?.layout ?? requestedLightLayout
		let demoTimer = null
		let demoButton = -1
		let lightMapping = initialLightLayout.buttonMappings
			? initialLightLayout.buttonMappings.map(({ player, eventType, index }, position) => ({ player, eventType, lightIndex: index ?? position }))
			: initialLightLayout.playerButtonEvents.reduce((mappings, events, player) => {
				events.forEach(eventType => mappings.push({ player, eventType, lightIndex: mappings.length }))
				return mappings
			}, [])
		let physicalLightCount = Math.max(savedMapping?.physicalLightCount ?? 0, initialLightLayout.buttonCount ?? 0, lightMapping.length, ...lightMapping.map(({ lightIndex }) => lightIndex + 1))
		let selectedMapping = null
		let mappingPreviewLight = null
		const mappedStates = new Map()
		const mappedTapStates = new Map()
		const activePicadeInputs = new Map()
		let inputHudFrame = null

		function formatPicadeInputAction(action) {
			return String(action ?? 'unknown control')
				.replace(/([a-z])([A-Z])/g, '$1 $2')
				.replace(/[-_]/g, ' ')
		}

		function renderPicadeInputHud() {
			const activeInput = Array.from(activePicadeInputs.values())
				.sort((left, right) => right.startedAt - left.startedAt)[0]
			if (!activeInput) {
				picadeInputHud.textContent = 'Waiting for Picade input.'
				inputHudFrame = null
				return
			}
			const heldSeconds = (performance.now() - activeInput.startedAt) / 1000
			picadeInputHud.textContent = `P${activeInput.player + 1} ${formatPicadeInputAction(activeInput.action)} held ${heldSeconds.toFixed(2)}s`
			inputHudFrame = requestAnimationFrame(renderPicadeInputHud)
		}

		function recordPicadeInput(player, action, pressed) {
			const key = `${player}:${action}`
			if (pressed) {
				activePicadeInputs.set(key, { player, action, startedAt: performance.now() })
			} else {
				activePicadeInputs.delete(key)
			}
			if (inputHudFrame == null) renderPicadeInputHud()
		}

		function getMappingText() {
			return Array.from({ length: physicalLightCount }, (_, lightIndex) => {
				const assignedMappings = lightMapping.filter(mapping => mapping.lightIndex === lightIndex)
				return assignedMappings.length
					? assignedMappings.map(({ player, eventType }) => player == null ? eventType : `${player + 1}${eventType}`).join('+')
					: '-'
			}).join(',')
		}

		function saveMapping() {
			try {
				window.localStorage.setItem(PICADE_MAPPING_STORAGE_KEY, JSON.stringify({
					mapping: getMappingText(),
					physicalLightCount,
				}))
			} catch {
				// Storage is optional, for example when a browser disables it for this page.
			}
		}

		function getMappingLabel({ player, eventType }) {
			return player == null ? `System ${eventType.toUpperCase()}` : `P${player + 1} ${eventType}`
		}

		function getMappedLightIndex(player, eventType) {
			return lightMapping.find(mapping => mapping.player === player && mapping.eventType === eventType)?.lightIndex ?? null
		}

		function ensureMappedLightIndex(player, eventType) {
			const mappedLightIndex = getMappedLightIndex(player, eventType)
			if (mappedLightIndex != null) return mappedLightIndex
			const eventIndex = PICADE_PLASMA_BUTTON_EVENTS.indexOf(eventType)
			if (eventIndex < 0 || physicalLightCount < 1) return null
			const playerLightIndexes = [...new Set(
				lightMapping
					.filter(mapping => mapping.player === player)
					.map(mapping => mapping.lightIndex),
			)]
			const lightIndex = playerLightIndexes.length
				? playerLightIndexes[eventIndex % playerLightIndexes.length]
				: eventIndex % physicalLightCount
			lightMapping.push({ player, eventType, lightIndex })
			renderMapping()
			console.info('[Picade mapping] assigned unmapped button to an existing light', {
				player,
				eventType,
				light: lightIndex + 1,
				mapping: getMappingText(),
			})
			return lightIndex
		}

		function syncMachineControlsToMapping() {
			machineLightCount.value = String(physicalLightCount)
		}

		function configureMachineLights() {
			const total = Math.max(1, Math.min(128, Math.round(Number(machineLightCount.value) || 1)))
			if (total === physicalLightCount) return
			// Light count changes must never reorder, drop, or swap button assignments.
			// A smaller panel simply combines out-of-range targets into its final light.
			for (const mapping of lightMapping) {
				mapping.lightIndex = Math.min(mapping.lightIndex, total - 1)
			}
			physicalLightCount = total
			machineLightCount.value = String(total)
			renderMapping()
		}

		function renderMapping() {
			mappingOutput.value = getMappingText()
			saveMapping()
			renderTestButtons()
			mappingSlots.replaceChildren(...Array.from({ length: physicalLightCount }, (_, lightIndex) => {
				const assignedMappings = lightMapping.filter(mapping => mapping.lightIndex === lightIndex)
				const item = document.createElement('li')
				item.className = 'mapping-slot'
				const button = document.createElement('button')
				button.type = 'button'
				button.classList.toggle('is-selected', assignedMappings.some(mapping => selectedMapping?.player === mapping.player && selectedMapping?.eventType === mapping.eventType))
				button.classList.toggle('is-pressed', assignedMappings.some(({ player, eventType }) => mappedStates.has(`${player}:${eventType}`)))
				button.setAttribute('aria-label', `Plasma light ${lightIndex + 1}: ${assignedMappings.map(getMappingLabel).join(', ') || 'unassigned'}`)
				button.addEventListener('click', () => flashPhysicalLight(lightIndex))
				const index = document.createElement('span')
				index.className = 'mapping-slot-index'
				index.textContent = `Light ${lightIndex + 1}`
				const control = document.createElement('span')
				control.className = 'mapping-slot-control'
				control.textContent = assignedMappings.map(getMappingLabel).join(' + ') || 'Unassigned'
				button.append(index, control)
				item.append(button)
				return item
			}))
			if (!selectedMapping) return
			const lightIndex = getMappedLightIndex(selectedMapping.player, selectedMapping.eventType)
			mappingSelection.textContent = `${getMappingLabel(selectedMapping)}: Plasma light ${lightIndex + 1}. Use joystick left/right to move it.`
		}

		function selectMapping(player, eventType) {
			if (getMappedLightIndex(player, eventType) == null) return false
			if (selectedMapping && (selectedMapping.player !== player || selectedMapping.eventType !== eventType) && mappingPreviewLight != null && plasma?.connected) {
				plasma.light(mappingPreviewLight, null)
				mappingPreviewLight = null
			}
			selectedMapping = { player, eventType }
			renderMapping()
			return true
		}

		function flashPhysicalLight(lightIndex) {
			if (!plasma?.connected) {
				status.textContent = `Plasma light ${lightIndex + 1} selected. Pair the lights to flash it green.`
				return
			}
			plasma.light(lightIndex, '#00ff66')
			plasma.fade(lightIndex, '#00ff66', { fadeTime: 0.45 })
			status.textContent = `Flashing Plasma light ${lightIndex + 1} green.`
		}

		function moveSelectedMapping(direction, source) {
			if (!selectedMapping) {
				console.warn('[Picade mapping] joystick navigation ignored: no selected button', { direction, source })
				mappingSelection.textContent = 'Press a mapped Picade button first, then use the joystick to move its light.'
				return false
			}
			const index = getMappedLightIndex(selectedMapping.player, selectedMapping.eventType)
			if (index == null || physicalLightCount < 2) {
				console.warn('[Picade mapping] joystick navigation ignored: selected button has no movable slot', {
					direction,
					source,
					selectedMapping,
					lightMapping,
				})
				return false
			}
			const nextIndex = (index + direction + physicalLightCount) % physicalLightCount
			const activeMapping = lightMapping.find(mapping => mapping.player === selectedMapping.player && mapping.eventType === selectedMapping.eventType)
			activeMapping.lightIndex = nextIndex
			if (controller) controller.lightInputFeedback = false
			renderMapping()
			const lightIndex = getMappedLightIndex(selectedMapping.player, selectedMapping.eventType)
			const state = mappedStates.get(`${selectedMapping.player}:${selectedMapping.eventType}`)
			if (plasma?.connected) {
				if (mappingPreviewLight != null && mappingPreviewLight !== lightIndex) plasma.light(mappingPreviewLight, null)
				if (index !== lightIndex && index !== mappingPreviewLight) plasma.light(index, null)
				plasma.light(lightIndex, MAPPING_PREVIEW_COLOR)
				mappingPreviewLight = lightIndex
			}
			if (state) state.lightIndex = lightIndex
			console.info('[Picade mapping] moved active light', {
				source,
				direction,
				selectedMapping,
				fromLight: index + 1,
				toLight: lightIndex + 1,
				mapping: getMappingText(),
				plasmaConnected: Boolean(plasma?.connected),
			})
			status.textContent = `${getMappingLabel(selectedMapping)} moved to Plasma light ${lightIndex + 1}.`
			return true
		}

		function pressMappedButton(player, eventType) {
			const lightIndex = ensureMappedLightIndex(player, eventType)
			if (lightIndex == null || mappedStates.has(`${player}:${eventType}`)) return
			selectMapping(player, eventType)
			if (mappingPreviewLight === lightIndex) mappingPreviewLight = null
			const key = `${player}:${eventType}`
			const now = performance.now()
			const previousTap = mappedTapStates.get(key)
			const tapIndex = previousTap && now - previousTap.at <= RAPID_TAP_WINDOW_MS
				? (previousTap.index + 1) % PICADE_RAPID_TAP_COLORS.length
				: 0
			const color = PICADE_RAPID_TAP_COLORS[tapIndex]
			mappedTapStates.set(key, { at: now, index: tapIndex })
			const state = { color, timer: null, lightIndex }
			mappedStates.set(key, state)
			renderMapping()
			if (plasma?.connected) plasma.light(lightIndex, state.color)
			state.timer = setTimeout(() => {
				if (!mappedStates.has(key)) return
				state.color = PICADE_LONG_PRESS_COLOR
				if (plasma?.connected) plasma.light(state.lightIndex, state.color)
			}, LONG_PRESS_MS)
		}

		function releaseMappedButton(player, eventType) {
			const key = `${player}:${eventType}`
			const state = mappedStates.get(key)
			if (!state) return
			clearTimeout(state.timer)
			mappedStates.delete(key)
			renderMapping()
			if (plasma?.connected) plasma.fade(state.lightIndex, state.color, { fadeTime: FADE_MS / 1000 })
		}

		function renderTestButtons() {
			const selectedLight = Math.min(Number(lightButtonSelect.value) || 0, Math.max(0, physicalLightCount - 1))
			lightButtonSelect.replaceChildren(...Array.from({ length: physicalLightCount }, (_, lightIndex) => {
				const assignedMappings = lightMapping.filter(mapping => mapping.lightIndex === lightIndex)
				const option = document.createElement('option')
				option.value = String(lightIndex)
				option.textContent = `Light ${lightIndex + 1}: ${assignedMappings.map(getMappingLabel).join(' + ') || 'Unassigned'}`
				return option
			}))
			lightButtonSelect.value = String(selectedLight)
			buttons = Array.from({ length: physicalLightCount }, (_, button) => {
				const assignedMappings = lightMapping.filter(mapping => mapping.lightIndex === button)
				const element = document.createElement('button')
				element.type = 'button'
				element.className = 'plasma-button'
				element.dataset.button = String(button)
				element.setAttribute('aria-describedby', 'press-help')
				const number = document.createElement('span')
				number.className = 'button-number'
				number.textContent = `Light ${button + 1}`
				const label = document.createElement('span')
				label.className = 'button-label'
				label.textContent = assignedMappings.map(getMappingLabel).join(' + ') || 'Unassigned'
				element.append(number, label)
				element.addEventListener('click', () => flashPhysicalLight(button))
				return element
			})
			buttonGrid.style.setProperty('--button-columns', String(Math.max(1, Math.ceil(buttons.length / 2))))
			buttonGrid.replaceChildren(...buttons)
		}

		function setVisual(button, color = null) {
			const element = buttons[button]
			if (!element) return
			element.classList.toggle('is-white', color === PICADE_SHORT_PRESS_COLOR)
			element.classList.toggle('is-red', color === PICADE_LONG_PRESS_COLOR)
		}

		function addGamepadDetail(list, label, value) {
			const term = document.createElement('dt')
			term.textContent = label
			const detail = document.createElement('dd')
			detail.textContent = value
			list.append(term, detail)
		}

		function renderGamepadInventory() {
			const gamepads = Array.from(navigator.getGamepads?.() ?? [])
			const slotCount = Math.max(4, gamepads.length)
			const connectedCount = gamepads.filter(gamepad => gamepad?.connected).length
			inventoryStatus.textContent = `${connectedCount} connected gamepad${connectedCount === 1 ? '' : 's'} in ${slotCount} browser-visible slot${slotCount === 1 ? '' : 's'}. The test uses the two Picade Max interfaces together through PicadeMaxController. Browsers expose a controller only after it has been used.`
			gamepadList.replaceChildren()

			for (let slot = 0; slot < slotCount; slot++) {
				const gamepad = gamepads[slot]
				const item = document.createElement('li')
				item.className = `gamepad-card${gamepad?.connected ? ' connected' : ''}`
				const device = getPicadeMaxGamepadInfo(gamepad)
				const heading = document.createElement('h4')
				heading.textContent = `Slot ${slot} — ${gamepad?.connected ? device ? 'Picade Max connected' : 'Connected' : 'Available / waiting'}`
				item.append(heading)

				if (!gamepad) {
					const message = document.createElement('p')
					message.textContent = 'No controller is currently exposed in this slot.'
					item.append(message)
					gamepadList.append(item)
					continue
				}

				const details = document.createElement('dl')
				const buttonStates = Array.from(gamepad.buttons, (button, index) => `${index}:${button.pressed ? 'pressed' : button.touched ? 'touched' : button.value.toFixed(2)}`).join('  ')
				const axisValues = Array.from(gamepad.axes, (axis, index) => `${index}:${axis.toFixed(3)}`).join('  ')
				addGamepadDetail(details, 'ID', gamepad.id || '(no name supplied)')
				addGamepadDetail(details, 'Manufacturer', device?.manufacturer ?? '(not identified)')
				addGamepadDetail(details, 'Product', device?.productName ?? '(not identified)')
				addGamepadDetail(details, 'USB vendor', device?.usbVendorName ?? '(not identified)')
				addGamepadDetail(details, 'USB ID', device ? `${device.vendorId.toString(16).padStart(4, '0')}:${device.productId.toString(16).padStart(4, '0')}` : '(not reported)')
				addGamepadDetail(details, 'Index', String(gamepad.index))
				addGamepadDetail(details, 'Connected', String(gamepad.connected))
				addGamepadDetail(details, 'Mapping', gamepad.mapping || '(none)')
				addGamepadDetail(details, 'Timestamp', String(gamepad.timestamp))
				addGamepadDetail(details, 'Buttons', `${gamepad.buttons.length}\n${buttonStates || '(none)'}`)
				addGamepadDetail(details, 'Axes', `${gamepad.axes.length}\n${axisValues || '(none)'}`)
				addGamepadDetail(details, 'Vibration', gamepad.vibrationActuator?.type ?? (gamepad.hapticActuators?.length ? `${gamepad.hapticActuators.length} haptic actuator(s)` : 'not reported'))
				item.append(details)
				gamepadList.append(item)
			}
		}

		function initialiseController() {
			const gamepads = findPicadeMaxInputGamepads()
			const key = gamepads.map(gamepad => [
				gamepad.index,
				gamepad.player,
				gamepad.source,
				gamepad.buttonOffset ?? 0,
				gamepad.axisOffset ?? 0,
				gamepad.id,
			].join(':')).join('|')
			if (gamepads.length !== 2) {
				gamepadStatus.textContent = `Waiting for two Picade Max player gamepads (${gamepads.length}/2 found)…`
				if (!plasma) setTestAvailability()
				return
			}
			if (key === controllerKey) return
			controller?.stop()
			controller = createPicadeMaxController(gamepads, {
				plasma: new PicadePlasma({
					buttonMappings: lightMapping.map(({ player, eventType, lightIndex }) => ({ player, eventType, index: lightIndex })),
					buttonCount: physicalLightCount,
					playerCount: 2,
				}),
				lightInputFeedback: true,
			})
			controllerKey = key
			console.info('[Picade test] controller player inputs', gamepads.map(gamepad => ({
				player: gamepad.player + 1,
				index: gamepad.index,
				source: gamepad.source,
				buttonOffset: gamepad.buttonOffset ?? 0,
				axisOffset: gamepad.axisOffset ?? 0,
				id: gamepad.id,
			})))
			plasma = controller.plasma
			updatePlasmaSerialStatus()
			plasma.on('tx', ({ raw, length }) => {
				plasmaCommandCount++
				const item = document.createElement('li')
				const preview = Array.from(raw.slice(0, 32), byte => byte.toString(16).padStart(2, '0')).join(' ')
				item.textContent = `#${plasmaCommandCount} ${new Date().toLocaleTimeString()} — ${length} bytes — ${preview}${length > 32 ? ' …' : ''}`
				plasmaCommandList.append(item)
			})
			controller.onButton(({ player, action, pressed, heldFor, gamepad }) => {
				recordPicadeInput(player, action, pressed)
				const eventDetail = { player, action, pressed, heldFor, gamepad: gamepad?.id, selectedMapping }
				if (action === PICADE_MAX_JOYSTICK_LEFT || action === PICADE_MAX_JOYSTICK_UP) {
					console.info('[Picade mapping] joystick previous event', eventDetail)
					if (pressed) return moveSelectedMapping(-1, action)
					return
				}
				if (action === PICADE_MAX_JOYSTICK_RIGHT || action === PICADE_MAX_JOYSTICK_DOWN) {
					console.info('[Picade mapping] joystick next event', eventDetail)
					if (pressed) return moveSelectedMapping(1, action)
					return
				}
			if ([DIRECTION_LEFT, DIRECTION_RIGHT, DIRECTION_UP, DIRECTION_DOWN].includes(action)) {
				console.info('[Picade mapping] raw joystick direction event', eventDetail)
				if (pressed) return moveSelectedMapping(
					action === DIRECTION_LEFT || action === DIRECTION_UP ? -1 : 1,
					action,
				)
				return
				}
				if (!PICADE_PLASMA_BUTTON_EVENTS.includes(action)) return
				if (pressed) pressMappedButton(player, action)
				else releaseMappedButton(player, action)
			})
			controller.start()
			const unavailablePlayers = gamepads.filter(gamepad => gamepad.source === 'placeholder')
			gamepadStatus.textContent = unavailablePlayers.length
				? `Player ${unavailablePlayers[0].player + 1} is not exposed by this browser yet. Press a control on that physical side, then check the gamepad inventory.`
				: `PicadeMaxController active: ${gamepads.map(gamepad => `P${gamepad.player + 1} in slot ${gamepad.index}`).join(', ')}.`
		}

		function setTestAvailability(message) {
			demoToggle.disabled = !plasma?.connected
			if (message) status.textContent = message
		}

		function showPlasmaConnectionFailure(error, { paired = true } = {}) {
			plasmaConnectionError = error instanceof Error ? error : new Error(String(error))
			plasmaSerialStatus.className = 'serial-status failed'
			plasmaSerialStatus.textContent = paired
				? `Plasma lights are paired but could not connect: ${plasmaConnectionError.message}`
				: `Plasma lights were not paired: ${plasmaConnectionError.message}`
			connect.disabled = false
			connect.textContent = paired ? 'Retry Plasma connection' : 'Pair Plasma lights'
			setTestAvailability(paired
				? 'Plasma lights are not ready. Select “Retry Plasma connection”.'
				: 'Plasma lights are not ready. Select “Pair Plasma lights”.')
		}

		async function updatePlasmaSerialStatus() {
			plasmaSerialStatus.className = 'serial-status'
			connect.hidden = false
			if (!plasma) {
				plasmaSerialStatus.textContent = 'Waiting for both Picade Max player gamepads.'
				connect.disabled = true
				connect.textContent = 'Pair Plasma lights'
				setTestAvailability('Connect both Picade Max player gamepads to activate the light test.')
				return
			}
			if (!('serial' in navigator)) {
				plasmaSerialStatus.classList.add('failed')
				plasmaSerialStatus.textContent = 'Web Serial is unavailable in this browser.'
				connect.disabled = true
				connect.hidden = true
				connect.textContent = 'Web Serial unavailable'
				setTestAvailability('Use Chrome, Edge, or the Electron app to connect the Plasma lights.')
				return
			}
			if (plasma.connected) {
				plasmaSerialStatus.classList.add('connected')
				plasmaSerialStatus.textContent = 'Connected — Plasma lights are ready.'
				connect.disabled = true
				connect.hidden = true
				plasmaConnectionError = null
				setTestAvailability('Ready — press a Picade button or start the light demo.')
				return
			}
			let pairedPorts
			try { pairedPorts = await plasma.getPairedPorts() }
			catch (error) { showPlasmaConnectionFailure(error); return }
			if (plasmaConnectionError) {
				showPlasmaConnectionFailure(plasmaConnectionError, { paired: Boolean(pairedPorts.length) })
				return
			}
			if (pairedPorts.length) {
				plasmaSerialStatus.classList.add('paired')
				plasmaSerialStatus.textContent = 'Paired — connecting to Plasma lights…'
				connect.disabled = true
				connect.hidden = true
				setTestAvailability('Connecting to the already paired Plasma lights…')
				if (!plasmaAutoConnecting) {
					plasmaAutoConnecting = true
					try { await controller.connectPlasma(); plasmaConnectionError = null }
					catch (error) { showPlasmaConnectionFailure(error) }
					finally { plasmaAutoConnecting = false; updatePlasmaSerialStatus() }
				}
			} else {
				plasmaSerialStatus.textContent = 'Not paired — choose Pair Plasma lights to continue.'
				connect.disabled = false
				connect.textContent = 'Pair Plasma lights'
				setTestAvailability('Action needed — pair the Plasma lights, then the test will be ready.')
			}
		}

		function runDemoStep() {
			if (demoTimer == null) return
			if (!buttons.length) return
			if (demoButton >= 0) setVisual(demoButton)
			demoButton = (demoButton + 1) % buttons.length
			setVisual(demoButton, PICADE_SHORT_PRESS_COLOR)
			plasma.fade(demoButton, PICADE_SHORT_PRESS_COLOR, { fadeTime: 0.35 })
			demoTimer = setTimeout(runDemoStep, 450)
		}

		async function stopDemo() {
			if (demoTimer == null) return
			clearTimeout(demoTimer)
			demoTimer = null
			if (demoButton >= 0) setVisual(demoButton)
			demoButton = -1
			demoToggle.setAttribute('aria-pressed', 'false')
			demoToggle.textContent = 'Start light demo'
			await plasma.clear()
			status.textContent = 'Light demo stopped. Plasma lights are clear.'
		}

		demoToggle.addEventListener('click', async () => {
			if (demoTimer != null) {
				await stopDemo()
				return
			}
			if (!plasma?.connected) {
				status.textContent = 'Pair the Plasma lights before starting the demo.'
				connect.focus()
				return
			}
			demoToggle.setAttribute('aria-pressed', 'true')
			demoToggle.textContent = 'Stop light demo'
			status.textContent = `Light demo running: flashing ${buttons.length} connected light${buttons.length === 1 ? '' : 's'} in sequence.`
			demoTimer = setTimeout(runDemoStep, 0)
		})
		connect.addEventListener('click', async () => {
			initialiseController()
			if (!controller) {
				status.textContent = 'Connect both Picade Max player gamepads before pairing the Plasma lights.'
				return
			}
			if (!('serial' in navigator)) {
				status.textContent = 'WebSerial is unavailable. Use Chrome, Edge, or the Electron app to pair the Plasma lights.'
				return
			}
			let pairingWasRequired = false
			try {
				connect.disabled = true
				plasmaConnectionError = null
				const pairedPorts = await plasma.getPairedPorts()
				pairingWasRequired = !pairedPorts.length
				status.textContent = pairedPorts.length
					? 'Retrying the connection to the paired Plasma lights…'
					: 'Choose the Picade Plasma serial device in the pairing prompt…'
				await controller.connectPlasma()
			} catch (error) {
				showPlasmaConnectionFailure(error, { paired: !pairingWasRequired })
			} finally {
				updatePlasmaSerialStatus()
			}
		})
		lightControls.addEventListener('submit', event => {
			event.preventDefault()
			if (!controller || !plasma?.connected) { status.textContent = 'Pair the Plasma lights before editing a light.'; return }
			const data = new FormData(lightControls)
			const button = Number(data.get('button'))
			const light = Number(data.get('light'))
			const color = data.get('color')
			const toColor = data.get('to-color')
			const brightness = Number(data.get('brightness'))
			const duration = Number(data.get('duration'))
			const mode = data.get('mode')
			if (!lightMapping[button]) { status.textContent = 'Choose a connected physical light.'; return }
			if (mode === 'blend') plasma.blendLight(button, light, color, toColor, { brightness, duration })
			else plasma.animateLight(button, light, mode, color, { brightness, duration, fadeTime: duration })
			const mapping = lightMapping[button]
			status.textContent = `Applied ${mode} to Plasma light ${button + 1}: ${getMappingLabel(mapping)}.`
		})
		copyLightMapping.addEventListener('click', async () => {
			mappingOutput.select()
			try {
				await navigator.clipboard.writeText(mappingOutput.value)
				mappingSelection.textContent = 'Mapping copied. Paste it after lights= in a PhotoSYNTH URL.'
			} catch {
				mappingSelection.textContent = 'Mapping selected. Copy it with your browser shortcut.'
			}
		})
		clearLightMapping.addEventListener('click', () => {
			for (const state of mappedStates.values()) clearTimeout(state.timer)
			mappedStates.clear()
			mappedTapStates.clear()
			activePicadeInputs.clear()
			if (inputHudFrame != null) cancelAnimationFrame(inputHudFrame)
			inputHudFrame = null
			renderPicadeInputHud()
			selectedMapping = null
			mappingPreviewLight = null
			lightMapping = []
			// The controller still has the previous hardware layout, so prevent it
			// from lighting legacy targets while this fresh mapping is established.
			if (controller) controller.lightInputFeedback = false
			if (plasma?.connected) plasma.clear().catch(error => console.warn('[Picade mapping] could not clear Plasma lights', error))
			renderMapping()
			mappingSelection.textContent = 'Mappings cleared. Press a Picade button to assign its first light.'
			status.textContent = `Cleared all button mappings. ${physicalLightCount} physical light${physicalLightCount === 1 ? '' : 's'} retained.`
		})
		document.addEventListener('keydown', event => {
			if (event.repeat || !['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'].includes(event.key)) return
			const target = event.target
			if (target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement || target instanceof HTMLSelectElement || target?.isContentEditable) return
			const direction = event.key === 'ArrowLeft' || event.key === 'ArrowUp' ? -1 : 1
			if (moveSelectedMapping(direction, `keyboard:${event.key}`)) event.preventDefault()
		})
		machineLightCount.addEventListener('change', configureMachineLights)
		syncMachineControlsToMapping()
		renderMapping()
		renderGamepadInventory()
		initialiseController()
		updatePlasmaSerialStatus()
		setInterval(() => { renderGamepadInventory(); initialiseController() }, 250)
