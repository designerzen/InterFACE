extends _base.pug

block title
	+title('Test: Picade Plasma')

block nav
	a(href="./tests.pug") All Tests

block main
	main#picade-plasma-test
		header.test-header
			div
				p.eyebrow Hardware test
				h2 Picade Plasma
				p Connect the controller, then press a button and move the joystick to align its light.
			form.global-light-count
				label(for="machine-light-count") Connected lights
				select#machine-light-count(name="lights")
					option(value="2") 2 lights
					option(value="4") 4 lights
					option(value="6" selected) 6 lights
					option(value="7") 7 lights
					option(value="8") 8 lights
					option(value="9") 9 lights
					option(value="10") 10 lights
					option(value="11") 11 lights
					option(value="12") 12 lights
					option(value="13") 13 lights
					option(value="14") 14 lights
					option(value="15") 15 lights
					option(value="16") 16 lights

		section.connection-panel(aria-label="Picade connection")
			div.connection-states
				div
					span.status-label Gamepads
					span#gamepad-status(role="status" aria-live="polite") Looking for Picade input…
				div
					span.status-label Plasma lights
					span#plasma-serial-status.serial-status(role="status" aria-live="polite") Checking Web Serial permission…
			div.connection-actions
				button#connect(type="button") Pair lights
				button#demo-toggle(type="button" aria-pressed="false" disabled) Start demo
			p#connection-status(role="status" aria-live="polite") Checking the Picade hardware…

		details.gamepad-panel
			summary Gamepad inventory
			p#gamepad-inventory-status(role="status" aria-live="polite") Checking browser-visible gamepads…
			ul#gamepad-list.gamepad-list

		section.mapping-panel(aria-labelledby="mapping-heading")
			h3#mapping-heading PhotoSYNTH light mapping
			p Press a Picade button to select it and preview its assigned Plasma light. Move the joystick left or right to change that button's target light.
			output#picade-input-hud.picade-input-hud(role="status" aria-live="polite") Waiting for Picade input.
			ol#light-mapping-slots.mapping-slot-grid(aria-label="Physical Plasma light slots")
			div.mapping-footer
				div.mapping-actions
					button#copy-light-mapping(type="button") Copy mapping
					button#clear-light-mapping(type="button") Clear mappings
					div.mapping-query
						label(for="light-mapping-output") Lights query
						textarea#light-mapping-output(readonly rows="1" spellcheck="false" aria-label="Current PhotoSYNTH lights query value")
				output#mapping-selection(role="status" aria-live="polite") Press a Picade button to edit its light position.

		details.light-controls-panel
			summary Direct LED editor
			form.light-controls#light-controls
				fieldset
					legend Plasma light editor
					label(for="light-button") Physical light
					select#light-button(name="button")
						each _, index in Array(6)
							option(value=index)= index + 1
					label(for="light-led") Light
					select#light-led(name="light")
						each _, index in Array(4)
							option(value=index)= index + 1
					label(for="light-mode") Mode
					select#light-mode(name="mode")
						option(value="normal") Steady
						option(value="flash") Flash
						option(value="pulse") Pulse
						option(value="fade") Fade
						option(value="blend") Blend
					label(for="light-color") Colour
					input#light-color(name="color" type="color" value="#ffffff")
					label(for="light-to-color") Blend to
					input#light-to-color(name="to-color" type="color" value="#ff0000")
					label(for="light-brightness") Brightness
					input#light-brightness(name="brightness" type="range" min="0" max="31" value="31")
					label(for="light-duration") Duration (s)
					input#light-duration(name="duration" type="number" min="0.1" max="10" step="0.1" value="0.7")
					button(type="submit") Apply light mode

		details.plasma-command-log
			summary Plasma transport commands
			p Every serial frame sent to the paired Picade Plasma controller is listed below.
			ol#plasma-command-list

		section#button-grid.button-grid(aria-label="Picade button test panel")
		p#press-help.help Short press: white. Hold: red. Release: fade out.

