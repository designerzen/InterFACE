					article.risk-card#r16(data-risk="r16 — private on-device camera use and participant distress")
						h3 R16 — Private on-device camera use and participant distress
						.table-scroll(tabindex="0", aria-label="Scrollable table: R16 — Private on-device camera use and participant distress")
