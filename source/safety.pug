								+actionRow("B2", "B", "Confirm accident/near-miss, RIDDOR and document-retention arrangements. Name the RIDDOR responsible person and decision route and confirm the enforcing-authority contact route.", "Team Lead + relevant employer")
				section.document-section#6-detailed-risk-register
					h2
