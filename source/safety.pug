		script.
			const themeToggle = document.querySelector('#theme-toggle');
			const themeToggleIcon = document.querySelector('#theme-toggle-icon');
			const themeToggleLabel = document.querySelector('#theme-toggle-label');
			const root = document.documentElement;
			
			function applyTheme(theme) {
			const isDark = theme === 'dark';
			root.dataset.theme = theme;
			themeToggleLabel.textContent = isDark ? 'Use light theme' : 'Use dark theme';
			themeToggleIcon.classList.toggle('icon--theme', !isDark);
			themeToggleIcon.classList.toggle('icon--theme-light', isDark);
			}
			
			let savedTheme = null;
			try {
			savedTheme = localStorage.getItem('safety-theme');
			} catch {}
			
			const preferredTheme = window.matchMedia?.('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
			applyTheme(savedTheme === 'dark' || savedTheme === 'light' ? savedTheme : preferredTheme);
			
			themeToggle.addEventListener('click', () => {
			const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
			applyTheme(nextTheme);
			try {
			localStorage.setItem('safety-theme', nextTheme);
			} catch {}
			});
			
			const incidentStorageKey = 'photosynth-safety-incident-records-v1';
			const incidentFieldNames = ['date', 'closed', 'hazard', 'action', 'control', 'restart'];
			const incidentRecords = document.querySelector('#incident-records');
			const incidentRecordTemplate = document.querySelector('#incident-record-template');
			const incidentStorageNote = document.querySelector('#incident-storage-note');
			const addIncidentRecordButton = document.querySelector('#add-incident-record');
			const toggleIncidentRecordsButton = document.querySelector('#toggle-incident-records');
			const toggleIncidentRecordsIcon = document.querySelector('#toggle-incident-records-icon');
			const toggleIncidentRecordsLabel = document.querySelector('#toggle-incident-records-label');
			
			function createIncidentId() {
			return `record-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 8)}`;
			}
			
			function emptyIncidentRecord(id = createIncidentId()) {
			return { id, open: true, date: '', closed: '', hazard: '', action: '', control: '', restart: '' };
			}
			
			function normaliseIncidentRecord(record) {
			const normalised = emptyIncidentRecord(
			typeof record?.id === 'string' && /^[a-zA-Z0-9_-]+$/.test(record.id) ? record.id : createIncidentId()
			);
			normalised.open = record?.open !== false;
			for (const fieldName of incidentFieldNames) {
			normalised[fieldName] = typeof record?.[fieldName] === 'string' ? record[fieldName] : '';
			}
			return normalised;
			}
			
			function readIncidentRecords() {
			try {
			const savedRecords = JSON.parse(localStorage.getItem(incidentStorageKey));
			if (Array.isArray(savedRecords) && savedRecords.length > 0) {
			return savedRecords.map(normaliseIncidentRecord);
			}
			} catch {}
			return [emptyIncidentRecord('record-1')];
			}
			
			function createIncidentRecordElement(record, recordNumber) {
			const fragment = incidentRecordTemplate.content.cloneNode(true);
			const details = fragment.querySelector('.incident-record');
			details.dataset.recordId = record.id;
			details.open = record.open;
			details.querySelector('.record-number').textContent = String(recordNumber);
			for (const fieldName of incidentFieldNames) {
			const control = details.querySelector(`[data-field="${fieldName}"]`);
			const controlId = `incident-${record.id}-${fieldName}`;
			control.id = controlId;
			control.value = record[fieldName];
			control.closest('label').htmlFor = controlId;
			}
			return details;
			}
			
			function collectIncidentRecords() {
			return [...incidentRecords.querySelectorAll('.incident-record')].map((details) => {
			const record = emptyIncidentRecord(details.dataset.recordId);
			record.open = details.open;
			for (const fieldName of incidentFieldNames) {
			record[fieldName] = details.querySelector(`[data-field="${fieldName}"]`).value;
			}
			return record;
			});
			}
			
			function saveIncidentRecords() {
			try {
			localStorage.setItem(incidentStorageKey, JSON.stringify(collectIncidentRecords()));
			incidentStorageNote.textContent = 'Records save automatically to this browser’s local storage on this device and are restored on reload. They are not transmitted; clearing browser site data removes them.';
			} catch {
			incidentStorageNote.textContent = 'Automatic saving is unavailable in this browser. Print or copy the record before leaving this page.';
			}
			}
			
			function updateIncidentDisclosureButton() {
			const records = [...incidentRecords.querySelectorAll('.incident-record')];
			const allExpanded = records.every((record) => record.open);
			toggleIncidentRecordsIcon.classList.toggle('is-collapse-action', allExpanded);
			toggleIncidentRecordsButton.setAttribute('aria-expanded', String(allExpanded));
			toggleIncidentRecordsLabel.textContent = allExpanded ? 'Collapse all' : 'Expand all';
			}
			
			function renderIncidentRecords(records) {
			incidentRecords.replaceChildren(...records.map((record, index) => createIncidentRecordElement(record, index + 1)));
			updateIncidentDisclosureButton();
			}
			
			renderIncidentRecords(readIncidentRecords());
			
			addIncidentRecordButton.addEventListener('click', () => {
			const record = emptyIncidentRecord();
			const details = createIncidentRecordElement(record, incidentRecords.children.length + 1);
			incidentRecords.append(details);
			updateIncidentDisclosureButton();
			saveIncidentRecords();
			details.querySelector('[data-field="date"]').focus();
			});
			
			toggleIncidentRecordsButton.addEventListener('click', () => {
			const records = [...incidentRecords.querySelectorAll('.incident-record')];
			const shouldExpand = records.some((record) => !record.open);
			for (const record of records) record.open = shouldExpand;
			updateIncidentDisclosureButton();
			saveIncidentRecords();
			});
			
			incidentRecords.addEventListener('input', saveIncidentRecords);
			incidentRecords.addEventListener('toggle', (event) => {
			if (event.target.matches('.incident-record')) {
			updateIncidentDisclosureButton();
			saveIncidentRecords();
			}
			}, true);
			
			const filterInput = document.querySelector('#risk-filter');
			const status = document.querySelector('#risk-filter-status');
			const emptyState = document.querySelector('#risk-empty');
			const riskCards = [...document.querySelectorAll('.risk-card')];
			const riskBands = ['low', 'moderate', 'high', 'very-high'];
			
			for (const card of riskCards) {
			const residualScore = card.querySelector('tbody tr > td:last-child');
			const residualBand = riskBands.find((band) => residualScore?.classList.contains(`score-${band}`));
			if (residualBand) card.dataset.residualRisk = residualBand;
			}

			function applyRiskFilter() {
			const filterTerm = filterInput.value.trim().toLocaleLowerCase('en-GB');
			let visible = 0;
			for (const card of riskCards) {
			const match = !filterTerm || card.textContent.toLocaleLowerCase('en-GB').includes(filterTerm);
			card.hidden = !match;
			if (match) visible += 1;
			}
			status.textContent = `${visible} of ${riskCards.length} risks shown`;
			emptyState.hidden = visible !== 0;
			}

			filterInput.addEventListener('input', applyRiskFilter);
			document.querySelector('#clear-filter').addEventListener('click', () => {
			filterInput.value = '';
			applyRiskFilter();
			filterInput.focus();
			});
			for (const printButton of document.querySelectorAll('[data-print-document]')) {
			printButton.addEventListener('click', () => window.print());
			}
			applyRiskFilter();
		script(type="module", src="./safety-pdf.js")
