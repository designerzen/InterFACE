mixin actionStatus(actionId)
	.action-status
		label.action-status__complete(for=`action-${actionId}`)
			input(id=`action-${actionId}`, type="checkbox", aria-describedby="action-plan-instructions")
			span Complete #{actionId}
		label.action-status__date(for=`action-${actionId}-date`)
			span Completion date
			input(id=`action-${actionId}-date`, type="date", aria-describedby="action-plan-instructions")

mixin actionRow(actionId, priority, actionText, owner)
	tr
		td= actionId
		td= priority
		td= actionText
		td= owner
		td
			+actionStatus(actionId)

mixin incidentRecord(recordId, recordNumber)
	details.incident-record(open, data-record-id=recordId)
		summary
			span.icon.icon--expand.incident-record__summary-icon(aria-hidden="true")
			span Record Incident
			span.record-number= recordNumber
		.incident-record__grid
			label.record-field.record-field--short(for=`incident-${recordId}-date`)
				span Date and time
				input(id=`incident-${recordId}-date`, type="datetime-local", data-field="date")
			label.record-field.record-field--short(for=`incident-${recordId}-closed`)
				span Closure date and time
				input(id=`incident-${recordId}-closed`, type="datetime-local", data-field="closed")
			label.record-field.record-field--long.record-field--wide(for=`incident-${recordId}-hazard`)
				span Change, hazard or incident
				textarea(id=`incident-${recordId}-hazard`, rows="4", data-field="hazard")
			label.record-field.record-field--long(for=`incident-${recordId}-action`)
				span Immediate action taken
				textarea(id=`incident-${recordId}-action`, rows="4", data-field="action")
			label.record-field.record-field--long(for=`incident-${recordId}-control`)
				span Further controls, action owner and due date
				textarea(id=`incident-${recordId}-control`, rows="4", data-field="control")
			label.record-field.record-field--short.record-field--wide(for=`incident-${recordId}-restart`)
				span Restart authorised by, role and time
				input(id=`incident-${recordId}-restart`, type="text", data-field="restart")

doctype html
html(lang="en-GB", class=classes)
	head
		meta(charset="utf-8")
		meta(name="viewport" content="width=device-width,initial-scale=1")
		meta(name="description" content="Expanded health and safety risk assessment for the PhotoSYNTH accessible musical instrument.")
		title PhotoSYNTH Accessible Musical Instrument | Risk assessment
		meta(name="robots" content="noindex")
		style.

			:root {
			color-scheme: light dark;
			--page: #ffffff;
			--canvas: #eef3f8;
			--ink: #202124;
			--muted: #5f6b7a;
			--navy: #17365d;
			--blue: #2e74b5;
			--blue-soft: #e8eef5;
			--line: #cbd5e1;
			--shadow: 0 1.25rem 3.5rem rgb(23 54 93 / 0.13);
			--low: #dff0d4;
			--moderate: #fff0b3;
			--high: #ffd7b5;
			--very-high: #f4cccc;
			--focus: #005fcc;
			font-family: Calibri, "Segoe UI", Arial, sans-serif;
			line-height: 1.5;
			}

			@supports (color: light-dark(white, black)) {
			:root {
			--page: light-dark(#ffffff, #121b28);
			--canvas: light-dark(#eef3f8, #0b111b);
			--ink: light-dark(#202124, #eef3f8);
			--muted: light-dark(#5f6b7a, #b6c2d0);
			--navy: light-dark(#17365d, #9cc7f0);
			--blue: light-dark(#2e74b5, #75b6ee);
			--blue-soft: light-dark(#e8eef5, #1b2d40);
			--line: light-dark(#cbd5e1, #435166);
			--low: light-dark(#dff0d4, #244322);
			--moderate: light-dark(#fff0b3, #4d4216);
			--high: light-dark(#ffd7b5, #59351c);
			--very-high: light-dark(#f4cccc, #5a2528);
			--focus: light-dark(#005fcc, #8bc8ff);
			}
			}

			:root[data-theme="light"] {
			color-scheme: light;
			--page: #ffffff;
			--canvas: #eef3f8;
			--ink: #202124;
			--muted: #5f6b7a;
			--navy: #17365d;
			--blue: #2e74b5;
			--blue-soft: #e8eef5;
			--line: #cbd5e1;
			--low: #dff0d4;
			--moderate: #fff0b3;
			--high: #ffd7b5;
			--very-high: #f4cccc;
			--focus: #005fcc;
			}

			:root[data-theme="dark"] {
			color-scheme: dark;
			--page: #121b28;
			--canvas: #0b111b;
			--ink: #eef3f8;
			--muted: #b6c2d0;
			--navy: #9cc7f0;
			--blue: #75b6ee;
			--blue-soft: #1b2d40;
			--line: #435166;
			--low: #244322;
			--moderate: #4d4216;
			--high: #59351c;
			--very-high: #5a2528;
			--focus: #8bc8ff;
			}

			html { box-sizing: border-box; scroll-behavior: smooth; }
			*, *::before, *::after { box-sizing: inherit; }
			body { margin: 0; background: var(--canvas); color: var(--ink); font-size: 1rem; }
			button, input, textarea { font: inherit; }
			a { color: var(--blue); text-underline-offset: .18em; overflow-wrap: anywhere; }
			a:hover { text-decoration-thickness: .14em; }
			:focus-visible { outline: .2rem solid var(--focus); outline-offset: .2rem; }

			.skip-link {
			position: fixed;
			inset-block-start: .5rem;
			inset-inline-start: .5rem;
			z-index: 20;
			translate: 0 -180%;
			padding: .7rem 1rem;
			border: .125rem solid currentColor;
			border-radius: .35rem;
			background: var(--page);
			color: var(--ink);
			}
			.skip-link:focus { translate: 0; }
			.visually-hidden {
			position: absolute !important;
			inline-size: 1px !important;
			block-size: 1px !important;
			margin: -1px !important;
			padding: 0 !important;
			overflow: hidden !important;
			border: 0 !important;
			clip-path: inset(50%) !important;
			white-space: nowrap !important;
			}

			.filter-bar {
			position: sticky;
			inset-block-start: 0;
			z-index: 10;
			display: flex;
			flex-wrap: nowrap;
			align-items: center;
			gap: .75rem;
			margin: 0 0 1.25rem;
			padding: .75rem;
			overflow-x: auto;
			border-block: .0625rem solid var(--line);
			background: var(--page);
			backdrop-filter: blur(.75rem);
			white-space: nowrap;
			}
			.filter-bar > * { flex: 0 0 auto; }
			.filter-bar label { color: var(--muted); font-size: .9rem; font-weight: 700; }
			.filter-bar input[type="text"] {
			flex: 1 1 24rem;
			min-inline-size: 12rem;
			min-block-size: 2.75rem;
			padding-inline: .8rem;
			border: .0625rem solid var(--line);
			border-radius: .45rem;
			background: var(--page);
			color: var(--ink);
			}
			.filter-bar button {
			min-block-size: 2.75rem;
			min-inline-size: 2.75rem;
			padding: .55rem .95rem;
			border: .0625rem solid var(--navy);
			border-radius: .45rem;
			background: var(--navy);
			color: var(--page);
			cursor: pointer;
			}
			.filter-bar__status { color: var(--muted); font-variant-numeric: tabular-nums; }
			.document-actions { display: flex; align-items: center; justify-content: flex-end; gap: .75rem; padding: .75rem clamp(1.25rem, 5vw, 4rem); background: var(--page); }
			.document-actions--top { border-block-end: .0625rem solid var(--line); }
			.document-actions--bottom { justify-content: flex-end; padding-inline: 0; padding-block-end: 0; }
			.document-actions__label { color: var(--navy); }
			.document-actions__controls { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .65rem; }
			.document-actions button {
			min-block-size: 2.75rem;
			padding: .55rem .95rem;
			border: .0625rem solid var(--navy);
			border-radius: .45rem;
			background: var(--navy);
			color: var(--page);
			cursor: pointer;
			}
			.icon {
			--icon: none;
			display: inline-block;
			flex: 0 0 auto;
			inline-size: 1.2em;
			block-size: 1.2em;
			background: currentColor;
			-webkit-mask: var(--icon) center / contain no-repeat;
			mask: var(--icon) center / contain no-repeat;
			}
			.icon--print { --icon: url("/source/assets/icons/local_printshop.svg"); }
			.icon--download { --icon: url("/source/assets/icons/download_for_offline_black_24dp.svg"); }
			.icon--theme { --icon: url("/source/assets/icons/dark_mode-24px.svg"); }
			.icon--theme-light { --icon: url("/source/assets/icons/light_mode-24px.svg"); }
			.icon--close { --icon: url("/source/assets/icons/close.svg"); }
			.icon--add { --icon: url("/source/assets/icons/add.svg"); }
			.icon--expand { --icon: url("/source/assets/icons/expand_more-24px.svg"); }
			.icon--document { --icon: url("/source/assets/icons/file_present.svg"); }
			.icon--scope { --icon: url("/source/assets/icons/info.svg"); }
			.icon--people { --icon: url("/source/assets/icons/groups.svg"); }
			.icon--assessment { --icon: url("/source/assets/icons/assessment.svg"); }
			.icon--actions { --icon: url("/source/assets/icons/check_circle_outline.svg"); }
			.icon--risks { --icon: url("/source/assets/icons/warning_amber.svg"); }
			.icon--checklist { --icon: url("/source/assets/icons/safety_check.svg"); }
			.icon--incident { --icon: url("/source/assets/icons/report.svg"); }
			.icon--approval { --icon: url("/source/assets/icons/verified-24px.svg"); }
			.button-with-icon { display: inline-flex; align-items: center; justify-content: center; gap: .45rem; }
			.button-with-icon[aria-busy="true"] { cursor: wait; opacity: .72; }
			.section-heading__icon { inline-size: 1.05em; block-size: 1.05em; }
			.pdf-export-status {
			position: fixed;
			z-index: 20;
			inset-inline: 1rem;
			inset-block-end: 1rem;
			max-inline-size: 38rem;
			margin: auto;
			padding: .75rem 1rem;
			border: .0625rem solid var(--line);
			border-radius: .45rem;
			background: var(--navy);
			color: var(--page);
			box-shadow: var(--shadow);
			}
			.pdf-export-status:empty { display: none; }

			.document {
			inline-size: min(74rem, calc(100% - 2rem));
			margin: 1.5rem auto 4rem;
			background: var(--page);
			box-shadow: var(--shadow);
			}
			.masthead { padding: clamp(2rem, 5vw, 4.5rem) clamp(1.25rem, 5vw, 4rem) 2rem; border-block-start: .55rem solid var(--navy); }
			.eyebrow { margin: 0 0 .4rem; color: var(--blue); font-size: .85rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
			h1, h2, h3, h4 { color: var(--navy); line-height: 1.18; text-wrap: balance; }
			h1 { max-inline-size: 22ch; margin: 0; font-size: clamp(2rem, 1.4rem + 3vw, 3.7rem); letter-spacing: -.025em; }
			.subtitle { margin: .65rem 0 1.8rem; color: var(--blue); font-size: clamp(1.1rem, .95rem + .6vw, 1.45rem); font-weight: 650; }
			h2 { margin: 0 0 1rem; font-size: clamp(1.55rem, 1.3rem + 1vw, 2.15rem); }
			h3 { margin: 0 0 .85rem; font-size: clamp(1.15rem, 1rem + .65vw, 1.5rem); }
			h4 { margin: 1rem 0 .4rem; font-size: 1rem; }
			p { max-inline-size: 76ch; margin: 0 0 .75rem; text-wrap: pretty; }
			ul { margin: .4rem 0 1rem; padding-inline-start: 1.4rem; }
			li { margin-block: .38rem; max-inline-size: 82ch; text-wrap: pretty; overflow-wrap: anywhere; }

			.toc { padding: 1rem clamp(1.25rem, 5vw, 4rem) 1.5rem; border-block: .0625rem solid var(--line); background: var(--blue-soft); }
			.toc h2 { margin-block-end: .55rem; font-size: 1rem; text-transform: uppercase; letter-spacing: .08em; }
			.toc ol { columns: 2 18rem; margin: 0; padding-inline-start: 1.35rem; }
			.toc li { break-inside: avoid; margin-block: .3rem; }

			main { padding: clamp(1.5rem, 4vw, 3.5rem) clamp(1.25rem, 5vw, 4rem); }
			.document-section { min-inline-size: 0; margin-block: 0 3rem; scroll-margin-block-start: 6rem; }
			.document-section > h2 { display: flex; align-items: center; gap: .55rem; padding-block-end: .55rem; border-block-end: .14rem solid var(--blue); }
			.risk-card {
			margin-block: 1.25rem;
			padding: 1.1rem;
			border: .0625rem solid var(--line);
			border-inline-start: .35rem solid var(--risk-outcome, var(--blue));
			border-radius: .5rem;
			scroll-margin-block-start: 6rem;
			}
			.risk-card[data-residual-risk="low"] { --risk-outcome: var(--low); }
			.risk-card[data-residual-risk="moderate"] { --risk-outcome: var(--moderate); }
			.risk-card[data-residual-risk="high"] { --risk-outcome: var(--high); }
			.risk-card[data-residual-risk="very-high"] { --risk-outcome: var(--very-high); }
			.risk-card[hidden] { display: none; }
			.risk-owner { max-inline-size: none; margin-block-start: .85rem; padding-block-start: .6rem; border-block-start: .0625rem solid var(--line); color: var(--muted); font-size: .93rem; }

			.callout { margin: 1rem 0 1.35rem; padding: .9rem 1rem; border: .0625rem solid var(--line); border-inline-start: .35rem solid var(--blue); background: var(--blue-soft); }
			.key-values { display: grid; grid-template-columns: minmax(9rem, 1fr) minmax(0, 2.7fr); margin: 1rem 0 1.5rem; border-block-start: .0625rem solid var(--line); }
			.key-values dt, .key-values dd { margin: 0; padding: .62rem .75rem; border-block-end: .0625rem solid var(--line); }
			.key-values dt { color: var(--navy); background: var(--blue-soft); font-weight: 750; }
			.key-values--wide { grid-template-columns: minmax(8rem, 1fr) minmax(12rem, 2fr) minmax(8rem, 1fr) minmax(12rem, 2fr); }

			.table-scroll { min-inline-size: 0; max-inline-size: 100%; inline-size: 100%; margin: 1rem 0 1.4rem; overflow-x: auto; border: .0625rem solid var(--line); border-radius: .4rem; }
			table { inline-size: 100%; border-collapse: collapse; font-size: .91rem; font-variant-numeric: tabular-nums; }
			caption { padding: .55rem .7rem; color: var(--muted); font-weight: 700; text-align: start; }
			th, td { padding: .55rem .65rem; border: .0625rem solid var(--line); text-align: start; vertical-align: middle; overflow-wrap: break-word; }
			thead th { background: var(--navy); color: var(--page); text-wrap: balance; }
			tbody th { color: var(--navy); background: var(--blue-soft); }
			.score-low { background: var(--low); font-weight: 800; text-align: center; }
			.score-moderate { background: var(--moderate); font-weight: 800; text-align: center; }
			.score-high { background: var(--high); font-weight: 800; text-align: center; }
			.score-very-high { background: var(--very-high); font-weight: 800; text-align: center; }

			.check-item { display: flex; align-items: flex-start; gap: .55rem; min-block-size: 2.2rem; }
			input[type="checkbox"] { flex: 0 0 auto; inline-size: 1.2rem; block-size: 1.2rem; margin-block-start: .12rem; accent-color: var(--blue); }
			.action-status { display: grid; gap: .6rem; min-inline-size: 10rem; }
			.action-status__complete { display: flex; align-items: center; gap: .45rem; color: var(--ink); font-weight: 700; white-space: nowrap; }
			.action-status__date { display: grid; gap: .2rem; color: var(--muted); font-size: .82rem; font-weight: 700; }
			.action-status__date input { min-block-size: 2.25rem; inline-size: 100%; padding: .25rem .35rem; border: .0625rem solid var(--line); border-radius: .3rem; background: var(--page); color: var(--ink); }
			.incident-record-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .65rem; margin-block: 1rem; }
			.incident-record-actions button { min-block-size: 2.75rem; padding: .55rem .85rem; border: .0625rem solid var(--navy); border-radius: .4rem; background: var(--navy); color: var(--page); cursor: pointer; }
			.icon--expand.is-collapse-action { transform: rotate(180deg); }
			.incident-records { display: grid; gap: 1rem; margin-block: 1rem 1.5rem; }
			.incident-record { min-inline-size: 0; margin: 0; padding: 1rem; border: .0625rem solid var(--line); border-radius: .45rem; }
			.incident-record summary { display: flex; align-items: center; gap: .4rem; color: var(--navy); font-size: 1.05rem; font-weight: 800; list-style: none; cursor: pointer; }
			.incident-record summary::-webkit-details-marker { display: none; }
			.incident-record[open] .incident-record__summary-icon { transform: rotate(180deg); }
			.incident-record[open] summary { margin-block-end: 1rem; }
			.incident-record__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .85rem; }
			.record-field { display: grid; align-content: start; gap: .3rem; min-inline-size: 0; color: var(--ink); font-weight: 700; }
			.record-field--wide { grid-column: 1 / -1; }
			.record-field input, .record-field textarea { inline-size: 100%; min-inline-size: 0; padding: .55rem; border: .0625rem solid var(--line); border-radius: .3rem; background: var(--page); color: var(--ink); }
			.record-field input { min-block-size: 2.75rem; }
			.record-field textarea { min-block-size: 7rem; resize: vertical; }
			.empty-state { padding: 1rem; border: .125rem dashed var(--line); color: var(--muted); }
			.source-note { color: var(--muted); font-size: .9rem; max-width:none; }
			footer { padding: 1rem clamp(1.25rem, 5vw, 4rem) 2rem; border-block-start: .0625rem solid var(--line); color: var(--muted); font-size: .85rem; }

			.pdf-export-source.document {
			inline-size: 184mm !important;
			margin: 0 !important;
			background: #fff;
			box-shadow: none !important;
			color: #000;
			color-scheme: light;
			font-size: 9.5pt;
			--page: #fff;
			--canvas: #fff;
			--ink: #000;
			--muted: #444;
			--navy: #17365d;
			--blue: #2e74b5;
			--blue-soft: #eef3f8;
			--line: #aab3bf;
			}
			.pdf-export-source .skip-link,
			.pdf-export-source .filter-bar,
			.pdf-export-source .toc,
			.pdf-export-source .document-actions,
			.pdf-export-source .incident-record-actions { display: none !important; }
			.pdf-export-source .icon { display: none !important; }
			.pdf-export-source .masthead { min-block-size: 235mm; padding: 22mm 9mm 8mm; }
			.pdf-export-source .pdf-cover-spacer { block-size: 5mm; }
			.pdf-export-source main { padding: 0; }
			.pdf-export-source .document-section { margin-block-end: 8mm; }
			.pdf-export-source .document-section > h2 { break-before: page; }
			.pdf-export-source .document-section:first-child > h2 { break-before: auto; }
			.pdf-export-source h2,
			.pdf-export-source h3,
			.pdf-export-source h4 { break-after: avoid-page; }
			.pdf-export-source p,
			.pdf-export-source li { orphans: 3; widows: 3; }
			.pdf-export-source .risk-card { break-inside: avoid; page-break-inside: avoid; margin-block: 5mm; padding: 4mm; }
			.pdf-export-source .table-scroll { overflow: visible; border: 0; }
			.pdf-export-source table { font-size: 7.8pt; }
			.pdf-export-source thead { display: table-header-group; }
			.pdf-export-source tr { break-inside: avoid; page-break-inside: avoid; }
			.pdf-export-source a { color: #000; text-decoration: none; }
			.pdf-export-source input[type="checkbox"] { appearance: none; inline-size: 3.5mm; block-size: 3.5mm; border: .3mm solid #000; }
			.pdf-export-source .action-status { min-inline-size: 25mm; gap: 1.5mm; }
			.pdf-export-source .action-status__date input { min-block-size: 5mm; border-color: #000; }
			.pdf-export-source .incident-records { gap: 6mm; }
			.pdf-export-source .incident-record { break-inside: avoid; padding: 4mm; border-color: #000; }
			.pdf-export-source .incident-record summary { margin-block-end: 4mm; color: #000; list-style: none; }
			.pdf-export-source .incident-record summary::-webkit-details-marker { display: none; }
			.pdf-export-source .incident-record > .incident-record__grid { display: grid !important; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4mm; }
			.pdf-export-source .record-field--wide { grid-column: 1 / -1; }
			.pdf-export-source .record-field input,
			.pdf-export-source .record-field textarea { display: none; }
			.pdf-export-source .record-field::after { content: ""; display: block; inline-size: 100%; }
			.pdf-export-source .record-field--short::after { min-block-size: 9mm; border-block-end: .3mm solid #000; }
			.pdf-export-source .record-field--long::after { min-block-size: 24mm; border: .3mm solid #000; }
			.pdf-export-source footer { padding: 4mm 0 0; }

			@media (max-width: 48rem) {
			.document { inline-size: 100%; margin-block-start: 0; box-shadow: none; }
			.key-values, .key-values--wide { grid-template-columns: minmax(7.5rem, .9fr) minmax(0, 2fr); }
			.toc ol { columns: 1; }
			.risk-card { padding: .85rem; }
			.incident-record__grid { grid-template-columns: 1fr; }
			.record-field--wide { grid-column: auto; }
			}

			@media (pointer: coarse) {
			.filter-bar button, .filter-bar input, input[type="checkbox"] { min-block-size: 2.75rem; }
			}

			@media (forced-colors: active) {
			:root { --line: CanvasText; --focus: Highlight; }
			.document, .risk-card, .callout, .table-scroll { box-shadow: none; }
			.score-low, .score-moderate, .score-high, .score-very-high { forced-color-adjust: auto; border: .14rem solid CanvasText; }
			}

