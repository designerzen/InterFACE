									th(scope="col") Likelihood / Severity
									th(scope="col") 1 Negligible
									th(scope="col") 2 Minor
									th(scope="col") 3 Moderate
									th(scope="col") 4 Major
									th(scope="col") 5 Catastrophic
							tbody
								tr
									td 5 Almost certain
									td.score-moderate 5
									td.score-high 10
									td.score-very-high 15
									td.score-very-high 20
									td.score-very-high 25
								tr
									td 4 Likely
									td.score-low 4
									td.score-moderate 8
									td.score-high 12
									td.score-very-high 16
									td.score-very-high 20
								tr
									td 3 Possible
									td.score-low 3
									td.score-moderate 6
									td.score-moderate 9
									td.score-high 12
									td.score-very-high 15
								tr
									td 2 Unlikely
									td.score-low 2
									td.score-low 4
									td.score-moderate 6
									td.score-moderate 8
									td.score-high 10
								tr
									td 1 Rare
									td.score-low 1
									td.score-low 2
									td.score-low 3
									td.score-low 4
									td.score-moderate 5
					.table-scroll(tabindex="0", aria-label="Scrollable table: 4. Risk scoring and acceptance")
						table
							caption 4. Risk scoring and acceptance
							thead
								tr
									th(scope="col") Score
									th(scope="col") Band
									th(scope="col") Required decision
							tbody
								tr
									td 1–4
									td Low
									td Proceed with controls; monitor.
								tr
									td 5–9
									td Moderate
									td Proceed only with named controls and routine supervision.
								tr
									td 10–14
									td High
									td Further control and named management approval required before starting/continuing.
								tr
									td 15–25
