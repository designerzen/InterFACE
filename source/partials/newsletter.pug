div#mc_embed_shell(aria-labelledby="newsletter-title")
	#mc_embed_signup
		form#mc-embedded-subscribe-form.validate(
			action="https://designerzen.us17.list-manage.com/subscribe/post?u=11c8e5b59b7e1f6f2e6424570&id=f8c2e29707&f_id=00fc8ae2f0"
			method="post"
			name="mc-embedded-subscribe-form"
			aria-describedby="newsletter-description"
			target="_blank"
		)
			#mc_embed_signup_scroll
				header.newsletter-header
					h5#newsletter-title Newsletter
					p#newsletter-description Occasional PhotoSYNTH updates, straight to your inbox.

				.subscribe-fields
					.mc-field-group
						label(for="mce-EMAIL") Email address
						input#mce-EMAIL.required.email(
							type="email"
							name="EMAIL"
							autocomplete="email"
							inputmode="email"
							enterkeyhint="send"
							placeholder="you@example.com"
							aria-describedby="newsletter-required"
							required
						)
						#newsletter-required.indicates-required
							span(aria-hidden="true") *
							|  Email address is required.
					input#mc-embedded-subscribe.button(type="submit" name="subscribe" value="Get updates")

				#mce-responses.clear(aria-live="polite")
					#mce-error-response.response(style="display: none;")
					#mce-success-response.response(style="display: none;")

				.mc-honeypot(aria-hidden="true" style="position:absolute;left:-5000px")
					//- Real people should not fill this in; it prevents bot signups.
					input(type="text" name="b_11c8e5b59b7e1f6f2e6424570_f8c2e29707" tabindex="-1" value="")

				p.mailchimp-referral
					a(href="https://eepurl.com/jCZOAM" rel="noopener noreferrer" target="_blank") Powered by Mailchimp
