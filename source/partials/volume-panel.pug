fieldset#mixer-panel.volume-mixer
	legend
		span.volume-control-name Volume
		span.mixer-control-name Mixer

	button#button-volume-mixer-mode.volume-mixer-mode-button(type="button" aria-label="Expand to full mixer" aria-controls="mixer-panel" aria-expanded="false")
		span(aria-hidden="true")

	fieldset.mixer-channel.mixer-channel-master
		legend Master
		label(for="mixer-master-volume") Master
		input#mixer-master-volume.vertical(type="range" min="0" max="1" step="0.01" list="volume-input-ticks" name="master-volume")
		.volume-step-controls(aria-label="Master volume adjustment controls")
			button.volume-step-button(type="button" data-volume-target="mixer-master-volume" data-volume-direction="decrease" aria-label="Decrease master volume") −
			button.volume-step-button(type="button" data-volume-target="mixer-master-volume" data-volume-direction="increase" aria-label="Increase master volume") +
		output#mixer-master-output(for="mixer-master-volume") 0%

	fieldset.mixer-channel.mixer-channel-percussion
		legend Beats
		label(for="mixer-percussion-volume") Percussion
		input#mixer-percussion-volume.vertical(type="range" min="0" max="1" step="0.01" list="volume-input-ticks" name="percussion-volume")
		.volume-step-controls(aria-label="Percussion volume adjustment controls")
			button.volume-step-button(type="button" data-volume-target="mixer-percussion-volume" data-volume-direction="decrease" aria-label="Decrease percussion volume") −
			button.volume-step-button(type="button" data-volume-target="mixer-percussion-volume" data-volume-direction="increase" aria-label="Increase percussion volume") +
		output#mixer-percussion-output(for="mixer-percussion-volume") 0%

	fieldset.mixer-channel.mixer-channel-sample
		legend SFX
		label(for="mixer-sample-volume") Samples
		input#mixer-sample-volume.vertical(type="range" min="0" max="1" step="0.01" list="volume-input-ticks" name="sample-volume")
		.volume-step-controls(aria-label="Sample volume adjustment controls")
			button.volume-step-button(type="button" data-volume-target="mixer-sample-volume" data-volume-direction="decrease" aria-label="Decrease sample volume") −
			button.volume-step-button(type="button" data-volume-target="mixer-sample-volume" data-volume-direction="increase" aria-label="Increase sample volume") +
		output#mixer-sample-output(for="mixer-sample-volume") 0%

	fieldset.mixer-channel.mixer-channel-trim
		legend Person Trim
		label(for="mixer-trim-volume") Person Trim
		input#mixer-trim-volume.vertical(type="range" min="0" max="1" step="0.01" list="volume-input-ticks" name="person-trim-volume")
		.volume-step-controls(aria-label="Person trim volume adjustment controls")
			button.volume-step-button(type="button" data-volume-target="mixer-trim-volume" data-volume-direction="decrease" aria-label="Decrease person trim volume") −
			button.volume-step-button(type="button" data-volume-target="mixer-trim-volume" data-volume-direction="increase" aria-label="Increase person trim volume") +
		output#mixer-trim-output(for="mixer-trim-volume") 0%

	datalist#volume-input-ticks
		option(value="0", label="0")
		option(value="0.1", label="0.1")
		option(value="0.2", label="0.2")
		option(value="0.3", label="0.3")
		option(value="0.4", label="0.4")
		option(value="0.5", label="0.5")
		option(value="0.6", label="0.6")
		option(value="0.7", label="0.7")
		option(value="0.8", label="0.8")
		option(value="0.9", label="0.9")
		option(value="1", label="1")

label.volume-mute-control(for="button-mute") Mute
	input#button-mute(type="checkbox" role="switch" aria-label="Toggle mute")