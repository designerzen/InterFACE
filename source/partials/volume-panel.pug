fieldset#volume-panel.volume.volume-compact
	legend Volume
	//- label(for="volume-input-range") 
	//- 	input(type="range" min="0" max="1" step="0.05" list="volume-input-ticks")#volume-input-range
		
	label(for="volume-input-range") 
		input(type="range" min="0" max="1" step="0.01" list="volume-input-ticks")#volume-input-range.vertical
		//- input(type="range" orient="vertical" min="0" max="1" step="0.05" list="volume-input-ticks")#volume-input-range
		datalist#volume-input-ticks
			option(value="0", label="0")
			option(value="0.1", label="0.1")
			option(value="0.2", label="0.2")
			option(value="0.3", label="0.3")
			option(value="0.4", label="0.4")
			option(value="0.5", label="0.5")
			option(value="0.6", label="0.6")
			option(value="0.7", label="0.7")
			option(value="0.8", label="0.8")
			option(value="0.9", label="0.9")
			option(value="1", label="1")

		//- datalist#l
			- for(let i = 0; i <= e; i++)
			option(value=i style=`--idx: ${i}` label=i%major ? null : i)

	output(for="volume-input-range")#volumeoutput 0

fieldset#mixer-panel.volume-mixer
	legend Mixer

	.mixer-channel
		label(for="mixer-master-volume") Master
		input#mixer-master-volume.vertical(type="range" min="0" max="1" step="0.01" list="volume-input-ticks" name="master-volume")
		output#mixer-master-output(for="mixer-master-volume") 0%

	.mixer-channel
		label(for="mixer-percussion-volume") Percussion
		input#mixer-percussion-volume.vertical(type="range" min="0" max="1" step="0.01" list="volume-input-ticks" name="percussion-volume")
		output#mixer-percussion-output(for="mixer-percussion-volume") 0%

	.mixer-channel
		label(for="mixer-sample-volume") Samples
		input#mixer-sample-volume.vertical(type="range" min="0" max="1" step="0.01" list="volume-input-ticks" name="sample-volume")
		output#mixer-sample-output(for="mixer-sample-volume") 0%

	.mixer-channel
		label(for="mixer-trim-volume") Person Trim
		input#mixer-trim-volume.vertical(type="range" min="0" max="1" step="0.01" list="volume-input-ticks" name="person-trim-volume")
		output#mixer-trim-output(for="mixer-trim-volume") 0%

label.volume-mute-control(for="button-mute") Mute
	input#button-mute(type="checkbox" role="switch" aria-label="Toggle mute")
