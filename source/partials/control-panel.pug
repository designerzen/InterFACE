	//- Controls for all players
	div#shared-controls.controls

		p.sr-only Shared controls that apply to all players

		//- button.button-install#button-install( type="button" hidden aria-label="Install this application to your homescreen") Install
		//- button.button-upgrade#button-upgrade( type="button" hidden aria-label="Upgrade this app to the latest version") Upgrade

		button#button-help( type="button" aria-label="Show help screen" onclick="window.help.showModal();" ) Help!<span class="hide-text"> me</span>
		
		button#button-command-palette.command-palette-launcher(type="button" aria-haspopup="dialog" aria-controls="command-palette" aria-label="Open command palette" hidden)
			| Commands
			kbd(aria-hidden="true") Ctrl K
				
		//- Equipment Settings 
		//- TODO: Put into a dialog?
		//- label#camera(for="select-camera") <span class="hide-text">Select </span>Camera
		//- 	select(aria-label="Select a different camera")#select-camera
		button#button-controls-list(type="button" aria-haspopup="dialog" aria-controls="control-panel" aria-expanded="false" aria-label="View controls as a list" hidden)
			span.controls-view-caption View: List
		label(for="button-settings") <span class="hide-text"> Change and edit </span>Settings<span class="hide-text"> that modify behaviour and sound</span>
			input(type="checkbox" aria-label="Show the settings panel")#button-settings
						

		//- Record / Save / Load --------------------------------------------------------------
		#control-panel-record(hidden).folder-menu.bottom.horizontal.right
			a.folder-link(href="#folder-record" aria-label="Show Recording options") <span class="hide-text">Show </span>Record<span class="hide-text">Optionss </span>
			menu.folder-content#folder-record
				include record-panel.pug
				a.folder-return(href="#control-panel" aria-label="Close panel") Return to the control menu

		//- label(for="button-midi-menu" ) MIDI<span class="hide-text"> Menu</span>
		//- 	input#button-midi-menu(type="checkbox" aria-label="Show MIDI Options")
		#control-panel-midi.folder-menu.bottom.horizontal.right(data-advanced-mode-only)
			a.folder-link(href="#folder-midi" aria-label="Show MIDI instruments") <span class="hide-text">Show </span>MIDI<span class="hide-text"> options</span>
			menu.folder-content#folder-midi
				include midi-panel.pug

		label(for="button-points") Points<span class="hide-text"> and achievements</span>
			input#button-points(type="checkbox" aria-label="Show and track points for players")

	
		//- Percussion and background accompanyment 
		label.keyboard-shortcut-control(for="button-percussion") Beats <span class="hide-text"> to jam along to</span>
			kbd.keyboard-shortcut(aria-hidden="true") B
			input#button-percussion(type="checkbox" aria-label="Play some background beats" aria-controls="percussion-settings")
		label.snare-reverb-control(for="snare-reverb-range" hidden) Snare space
			input#snare-reverb-range(type="range" min="0" max="1" step="0.05" value="0.24" aria-describedby="snare-reverb-value")
			output#snare-reverb-value(for="snare-reverb-range") 24%
		
		//button#button-percussion( aria-label="Toggle the backing track" ) Backing track
		//button#button-donk( aria-label="Put a donk on it" ) Add Donk
		//button#button-cowbell( aria-label="More cowbell!" ) Add Cowbell

		label.keyboard-shortcut-control(for="select-mtv") MTV
			kbd.keyboard-shortcut(aria-hidden="true") D
			select#select-mtv(aria-label="Choose MTV video effect")
				option(value="off" selected) Off
				option(value="disco") Classic MTV
		span(hidden)
			input#button-disco(type="checkbox" aria-label="Toggle MTV video effects")
		
		label.keyboard-shortcut-control(for="select-viz") Viz
			kbd.keyboard-shortcut(aria-hidden="true") Y
			select#select-viz(aria-label="Choose audio visualisation")
				option(value="vu" selected) VU
				option(value="spectrum") Spectrum
				option(value="mirror") Mirror
				option(value="wave") Waveform
				option(value="radial") Radial
				option(value="hybrid") Spectrum + Wave
				option(value="curve") Spectrum Contour
				option(value="peaks") Peak Hold
				option(value="envelope") Waveform Envelope
				option(value="wave-ring") Wave Ring
				option(value="phase") Phase Scope
				option(value="orbit") Harmonic Orbit
				option(value="lattice") Spectral Mosaic
				option(value="notes-horizontal") Notes Horizontal
				option(value="notes-vertical") Notes Vertical
				option(value="off") Off
		span(hidden)
			input#button-spectrogram(type="checkbox" aria-label="Toggle audio visualisation")

	

		//- button#toggle-synth( aria-label="Swap between synth and samples" ) Swap Engines
		
		//- Metronome ---------------------------------------------------------------------
		label.keyboard-shortcut-control(for="button-metronome") <span class="hide-text">Toggle </span>Metro&shy;nome
			kbd.keyboard-shortcut(aria-hidden="true") M
			input#button-metronome(type="checkbox" aria-label="Play a metronome to help you keep time")
		
		//- TEMPO -------------------------------------------------------------------------
		//- Drop up / down list of tempos with typeable option too
		//- Uses customizable <select> (appearance: base-select) with rich content
		label(for="select-tempo", hidden) <span class="hide-text">Set </span>Tempo
			select#select-tempo(aria-label="Choose a tempo from the list" name="select-tempo")
				optgroup(label="Slow")
					option(value="45" data-detail="BPM") 45
					option(value="60" data-detail="BPM") 60
					option(value="75" data-detail="BPM") 75
				optgroup(label="Medium")
					option(value="85" data-detail="BPM") 85
					option(value="90" data-detail="BPM") 90
					option(value="100" data-detail="BPM") 100
					option(value="110" data-detail="BPM") 110
					option(value="120" data-detail="BPM" selected) 120
				optgroup(label="Fast")
					option(value="130" data-detail="BPM") 130
					option(value="140" data-detail="BPM") 140
					option(value="150" data-detail="BPM") 150
				optgroup(label="Extreme")
					option(value="200" data-detail="BPM") 200
					option(value="300" data-detail="BPM") 300
					option(value="400" data-detail="BPM") 400
					option(value="500" data-detail="BPM") 500
		#control-panel-tempo.folder-menu.bottom.horizontal.right
			a.folder-link(href="#folder-tempo" aria-label="Show timing options") <span class="hide-text">Show </span>tempo<span class="hide-text"> options</span>
			menu.folder-content#folder-tempo
				include tempo-panel.pug
				a.folder-return(href="#control-panel" aria-label="Close panel") Return to the control menu

		include looking-glass-panel.pug

		label(for="select-key") <span class="hide-text">Choose </span>Key
			select#select-key(aria-label="Select global musical tonic")
				option(value="free-range")&attributes({ 'data-detail': 'no shared key', 'data-icon': optionPath('M6 8a4 4 0 1 0 0 8c3.5 0 8.5-8 12-8a4 4 0 1 1 0 8c-3.5 0-8.5-8-12-8z') }) Free Range
				hr
				option(value="C") C
				option(value="Db") Db / C#
				option(value="D") D
				option(value="Eb") Eb / D#
				option(value="E") E
				option(value="F") F
				option(value="Gb") Gb / F#
				option(value="G") G
				option(value="Ab") Ab / G#
				option(value="A") A
				option(value="Bb") Bb / A#
				option(value="B") B

		label(for="select-key-scale") <span class="hide-text">Choose </span>Mode
			select#select-key-scale(aria-label="Select global musical scale or mode")
				+icon-group("Common", "M9 18V5l11-2v13M9 18a3 3 0 1 1-6 0 3 3 0 0 1 6 0zM20 16a3 3 0 1 1-6 0 3 3 0 0 1 6 0z")
					option(value="CHROMATIC_SCALE") Chromatic
					option(value="MAJOR_SCALE") Major / Ionian
					option(value="NATURAL_MINOR_SCALE") Natural Minor / Aeolian
					option(value="HARMONIC_MINOR_SCALE") Harmonic Minor
					option(value="MELODIC_MINOR_SCALE") Melodic Minor
				+icon-group("Major Modes", "M3 20h4v-5h4v-5h4V5h6")
					option(value="DORIAN_SCALE") Dorian
					option(value="PHRYGIAN_SCALE") Phrygian
					option(value="LYDIAN_SCALE") Lydian
					option(value="MIXOLYDIAN_SCALE") Mixolydian
					option(value="LOCRIAN_SCALE") Locrian
				+icon-group("Pentatonic", "m12 3 9 7-3.5 11h-11L3 10z")
					option(value="PENTATONIC_MAJOR_SCALE") Pentatonic Major
					option(value="PENTATONIC_MINOR_SCALE") Pentatonic Minor
				+icon-group("Symmetric", "M12 3v18M3 12h18M5.5 5.5l13 13M18.5 5.5l-13 13")
					option(value="WHOLE_TONE_SCALE") Whole Tone
					option(value="DIMINISHED_SCALE") Diminished
					option(value="AUGMENTED_SCALE") Augmented
				+icon-group("Other", "M3 12c3-7 6-7 9 0s6 7 9 0")
					option(value="BLUES_SCALE") Blues
					option(value="FIFTHS_SCALE") Circle of Fifths


		//- Volumes -------------------------------------------------------------------------------
		include backing-melody-panel.pug
				a.folder-return(href="#control-panel" aria-label="Close panel") Return to the control menu

		#control-panel-volume.folder-menu.inline.up
			a.folder-link(href="#folder-volume" aria-label="Show volume or mixer controls")
				span.volume-control-name Volume
				span.mixer-control-name Mixer
			menu.folder-content#folder-volume
				include volume-panel.pug
				a.folder-return(href="#control-panel" aria-label="Close panel") Return to the control menu

		//- put share and full screen at the end
		button.hide-text#button-share( type="button" aria-label="Share this with your friends" onclick="document.getElementById('share-menu').share()" ) <span class="sr-only">Share</span>
		
		label.hide-text.keyboard-shortcut-control(for="button-fullscreen") Toggle Fullscreen
			kbd.keyboard-shortcut(aria-hidden="true") F
			input#button-fullscreen(type="checkbox"  aria-label="Toggle full screen mode")
	

