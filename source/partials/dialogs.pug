dialog#pwa-updates
	//-iframe#changelog(src="./changes.html" title="Changes")
	form(method="dialog")
		h5 Updates available!
		#changelog

		button.button-push.text-always#button-update(autofocus type="button" title="Upgrade to the latest version") Upgrade 
		button.button-push.text-always.close(onclick="this.closest('dialog').close('close')" type="submit" title="Close dialog") Continue without update 
	
dialog#errors(aria-labelledby="error-title" aria-describedby="error-message error-solution")
	form(method="dialog")
		h5#error-title Something went wrong
		p#error-message PhotoSYNTH could not continue.
		p#error-solution Please try again.
		
		details#error-help
			summary#error-help-label Camera help
			p#error-help-text

		details#error-technical
			summary#error-details-label Technical details
			p#error-details

		audio(src="./assets/audio/lemmings.wav" controls=false)

		menu
			button.button.button-push.text-always.reload-app(autofocus type="button")
				span#error-primary-label Try again
			button.button.button-push.text-always.camera-help(type="button")
				span#error-secondary-label Camera help
	
		button.close.if-recoverable(autofocus onclick="this.closest('dialog').close('close')" type="submit" title="Close dialog") Return 


dialog#select-midi
	form(method="dialog")
		h5 Select your MIDI device
		label(for="select-midi-output") <span class="hide-text">Connect to </span>MIDI
		div#select-midi-output
			input.midi-output(type="checkbox" aria-label="Select MIDI Device to play")

		button.close(autofocus onclick="this.closest('dialog').close('close')" type="submit" title="Close dialog") Return 
