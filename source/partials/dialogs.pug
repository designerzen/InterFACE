template#person-report-template
	dialog.person-report-dialog
		header
			h2(data-report-title) Progress & data
			button(type="button" data-report-close autofocus) Close
		p(data-report-description) Current player session. Player mode time measures time in that mode; movement activity is a camera-based measure, not an assessment of wellbeing or benefit. Points and achievements may include earlier sessions in this app run.
		p(data-report-summary)
		p(data-report-time role="status")
		.person-report-actions
			button(type="button" data-report-refresh) Refresh snapshot
			button(type="button" data-report-export="csv") Export CSV
			button(type="button" data-report-export="json") Export JSON
		p Exports include the displayed player name. Save dated snapshots to compare sessions. Data is downloaded to your device.
		details(open)
			summary Activity & analysis
			p Durations are milliseconds; activity values and movement totals use normalised units. Notes use MIDI numbers and ranges use semitones. Note events include changes of playing state; the event rate uses Player mode time. A dash means no data yet.
			table
				caption Player session measures
				thead
					tr
						th(scope="col") Measure
						th(scope="col") Value
				tbody(data-report-metrics)
		details
			summary Unlocked achievements
			ul(data-report-achievements)

dialog#midi-cc-dialog.midi-cc-dialog(aria-labelledby="midi-cc-dialog-title" aria-describedby="midi-cc-dialog-description")
	form(method="dialog")
		header.midi-cc-dialog-header
			h2#midi-cc-dialog-title MIDI CC controls
			button(type="submit" value="close" autofocus aria-label="Close MIDI CC reference") Close ×
		p#midi-cc-dialog-description PhotoSYNTH app assignments. Enable MIDI and two-way CC control, then send Control Change messages on app control channel #[strong#midi-cc-reference-channel 16]. Changes also send to connected outputs.
		p.midi-cc-hint CC numbers and values are decimal (0–127). Switches: 0–63 off, 64–127 on. Faders: 0 = minimum, 127 = maximum. Selectors: options are evenly spaced from 0 to 127, in the order shown.
		.midi-cc-table-scroll(tabindex="0" role="region" aria-label="MIDI CC assignments")
			table.midi-cc-table
				caption All supported app CC assignments
				thead
					tr
						th(scope="col") CC
						th(scope="col") Control
						th(scope="col") Values / mapping
				tbody#midi-cc-reference

dialog#command-palette.command-palette(aria-labelledby="command-palette-title" aria-describedby="command-palette-description")
	form.command-palette-shell(method="dialog")
		header.command-palette-header
			h4#command-palette-title Commands
			p#command-palette-description Search for a section, control, or action.
			label.sr-only(for="command-palette-search") Search commands
			input#command-palette-search.command-palette-search(type="search" autocomplete="off" spellcheck="false" placeholder="Type a command…" role="combobox" aria-autocomplete="list" aria-controls="command-palette-results" aria-expanded="true" autofocus)
		div#command-palette-results.command-palette-results(role="listbox" aria-label="Available commands")
		p.command-palette-empty(role="status" hidden) No matching commands
		footer.command-palette-footer(aria-hidden="true")
			span: kbd ↑↓
			|  Navigate
			span: kbd Enter
			|  Run
			span: kbd Esc
			|  Close
		button.command-palette-close(type="submit" value="close" aria-label="Close command palette") ×

dialog#keyboard-guide.keyboard-guide(aria-labelledby="keyboard-guide-title" aria-describedby="keyboard-guide-description")
	form.keyboard-guide-shell(method="dialog")
		header.keyboard-guide-header
			h4#keyboard-guide-title Keyboard
			p.keyboard-guide-current(role="status" aria-live="polite")
		p#keyboard-guide-description.sr-only Select a sound mode, then press any key shown below to perform its labelled action.
		div.keyboard-mode-heading
			span Sound mode
			small PgUp / PgDn change mode · Number keys always play Cosmo sounds
		nav.keyboard-mode-picker(aria-label="Keyboard modes")
			button(type="button" data-keyboard-mode="0")
				span Operational
			button(type="button" data-keyboard-mode="1")
				span Notes
			button(type="button" data-keyboard-mode="2")
				span Notes +1
			button(type="button" data-keyboard-mode="3")
				span Chords
			button(type="button" data-keyboard-mode="4")
				span Percussion
			button(type="button" data-keyboard-mode="5")
				span Samples
		section.keyboard-layout(aria-label="QWERTY keyboard shortcut map")
			div#keyboard-guide-keys
		button.close(autofocus onclick="this.closest('dialog').close('close')" type="submit" title="Close dialog") Close Keyboard

dialog#help(aria-label="Help")
	form(method="dialog")
		include help-content.pug
		small.version Version #{package.version}
		button.close(autofocus onclick="this.closest('dialog').close('close')" type="submit" aria-label="Close help")

