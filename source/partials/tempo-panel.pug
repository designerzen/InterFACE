#tempo-tabs.tabs
	div.tabs-list(role="tablist" aria-label="Tempo settings")
		button#tempo-tab.tab(type="button" role="tab" aria-selected="true" aria-controls="tempo-regular-panel" tabindex="0") Tempo
		button#tempo-sync-tab.tab(type="button" role="tab" aria-selected="false" aria-controls="network-timing" tabindex="-1") Sync
	fieldset#tempo-regular-panel.form-tempo.tabs-panel(role="tabpanel" aria-labelledby="tempo-tab")
		legend Set Tempo
	
		label(for="tempo-input-text") Enter tempo
		input(type="number" min="1" max="300" inputmode="numeric" pattern="[0-9]+")#tempo-input-text

		label(for="tempo-input-range") Set tempo
		input(type="range" min="1" max="300" step="0.5" list="tempo-input-ticks")#tempo-input-range
		datalist#tempo-input-ticks
			option(value="1", label="1")
			option(value="100", label="100")
			option(value="200", label="200")
			option(value="300", label="300")

		label(for="tempo-swing-range") Set swing
		input(type="range" min="0" max="1" step="0.01" list="tempo-swing-ticks")#tempo-swing-range
		datalist#tempo-swing-ticks
			option(value="0", label="0%")
			option(value="0.5", label="50%")
			option(value="1", label="100%")
		output(for="tempo-swing-range")#tempo-swing-output 0%

		button(type="button" aria-keyshortcuts="ArrowRight" title="Increase tempo (Right arrow while the Tempo panel is focused)")#tempo-increase-button.button-bpm-up.keyboard-shortcut-control Tempo Increase
			kbd.keyboard-shortcut(aria-hidden="true") →
		button(type="button" aria-keyshortcuts="ArrowLeft" title="Decrease tempo (Left arrow while the Tempo panel is focused)")#tempo-decrease-button.button-bpm-down.keyboard-shortcut-control Tempo Decrease
			kbd.keyboard-shortcut(aria-hidden="true") ←

		button(type="button" aria-keyshortcuts="x" title="Tap tempo (X while the Tempo panel is focused)")#tempo-tap-button.button-bpm-tap.round.keyboard-shortcut-control Tap Tempo
			kbd.keyboard-shortcut(aria-hidden="true") X

		output#timing-feedback

	fieldset#network-timing.form-network-timing.tabs-panel(role="tabpanel" aria-labelledby="tempo-sync-tab" hidden)
		legend Play together
		p Share tempo and swing directly with nearby machines on the same network.
		label(for="timing-room-id") Room code
		input#timing-room-id(type="text" minlength="6" maxlength="80" autocomplete="off" spellcheck="false")
		div.timing-room-actions
			button#timing-room-host(type="button") Host a room
			button#timing-room-invite(type="button" disabled) Invite another guest
			button#timing-room-leave(type="button" disabled) Leave room
		label(for="timing-room-pairing") Invitation or response link
		textarea#timing-room-pairing(rows="3" autocomplete="off" spellcheck="false" placeholder="Paste the host’s invitation, or a guest’s response")
		div.timing-room-actions
			button#timing-room-join(type="button") Import link
			button#timing-room-scan(type="button") Scan QR code
		label(for="timing-room-image") Or read a QR image
		input#timing-room-image(type="file" accept="image/*")
		div#timing-room-scanner(hidden)
			video#timing-room-video(autoplay playsinline muted aria-label="QR scanner camera")
			button#timing-room-stop-scan(type="button") Stop scanning
		output#timing-room-status(role="status" aria-live="polite") Playing on my own
		p#timing-room-error(role="alert" hidden)
		ul#timing-room-peers(aria-label="Connected machines")
		div.timing-room-actions
			button#timing-room-start(type="button" disabled) Start together
			button#timing-room-pause(type="button" disabled) Pause together
		p The host controls tempo and swing. Changes take effect together at the next shared boundary.
		p Each guest needs their own invitation. Return the response to the host to finish joining. Keep the host’s page open; refreshing requires pairing again. Guest Wi-Fi isolation can prevent connections.
		div#timing-room-share(hidden)
			p#timing-room-share-help
			div#timing-room-qr(role="img" aria-label="Pairing QR code")
			p#timing-room-qr-warning(role="status")
			a#timing-room-link(target="_blank" rel="noopener")
			button#timing-room-copy(type="button") Copy pairing link

fieldset(hidden).form-tempo-synch
	label(for="tempo-clock-select") Synch Clock To
	select#tempo-clock-select
		option Internal clock

	label(for="tempo-worker") Engine
	select#tempo-worker
		option SetTimeOut Loop
		option SetInterval Loop
		option SetTimeOut Rolling

	label(for="tempo-midi-synch") MIDI Toggle
		input(type="checkbox" value="MIDI Synch")#tempo-midi-synch.toggle

fieldset(hidden).form-tempo-output
	output#timing-events-output

	output#timing-beat-output
	output#timing-bar-output

	label(for="midi-inputs-output") MIDI Devices Inputs
	output#midi-inputs-output

	label(for="midi-outputs-output") MIDI Devices Outputs
	output#midi-outputs-output

	fieldset 
		output#tempo-lag-output
		output#tempo-drift-output
		output#timer-elapsed-output

	button(type="button")#tempo-reset Reset

