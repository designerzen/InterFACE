{
	"name": "PhotoSYNTH",
	"packageManager": "pnpm@12.18.0",
	"description": "Instant Musical Superpowers! Body controllable accessible musical instrument",
	"version": "0.60.5",
	"time": 1786271335986,
	"author": "designerzen <github@designerzen.com>",
	"license": "AGPL-3.0-or-later",
	"repository": "https://github.com/designerzen/InterFACE.git",
	"bugs": "https://github.com/designerzen/InterFACE/issues",
	"homepage": "https://interface.place",
	"service-worker": "releases/web/service-worker.bundle.js",
	"keywords": [
		"music",
		"accessibility",
		"machine learning",
		"ai",
		"xr",
		"ar"
	],
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24.11.0",
			"onFail": "download"
		}
	},
	"main": "dist-electron/electron/main.js",
	"alias": {
		"three/addons/loaders/FBXLoader.js": "three/examples/jsm/loaders/FBXLoader.js",
		"three/webgpu": "three/build/three.webgpu.js",
		"three/tsl": "three/build/three.tsl.js"
	},
	"targets": {
		"main": false,
		"electron-preload": {
			"source": "source/electron/preload.ts",
			"distDir": "./dist-electron/electron/",
			"context": "electron-renderer",
			"publicUrl": "./",
			"sourceMap": false,
			"engines": {
				"electron": ">=19.x"
			}
		},
		"electron-main": {
			"source": "source/electron/main.ts",
			"distDir": "./dist-electron/electron/",
			"context": "electron-main",
			"publicUrl": "./",
			"sourceMap": true,
			"scopeHoist": false
		},
		"electron-renderer": {
			"source": "source/app.pug",
			"includeNodeModules": true,
			"distDir": "./dist-electron/main",
			"publicUrl": "./",
			"context": "electron-renderer",
			"sourceMap": true
		},
		"web": {
			"source": ["source/index.pug", "source/404.pug"],
			"distDir": "./releases/web/",
			"publicUrl": "./",
			"context": "browser",
			"sourceMap": false,
			"scopeHoist": false
		},
		"dev": {
			"source": "source/sitemap.pug",
			"distDir": "./releases/web/",
			"publicUrl": "./",
			"context": "browser",
			"sourceMap": true
		},
		"service-worker": {
			"source": "source/service-worker.js",
			"distDir": "./releases/web/",
			"publicUrl": "./",
			"context": "service-worker",
			"outputFormat": "esmodule",
			"sourceMap": false,
			"scopeHoist": false
		}
	},
	"scripts": {
		"backing:model:install": "node actions/install-backing-model.cjs",
		"optional": "node-gyp-build-optional-packages",
		"secure": "pnpm dlx @socketsecurity/cli optimize",
		"=TEST=": "------------------------------------",
		"test": "jest",
		"test-watch": "jest --watch",
		"test:levels": "node actions/check-instrument-levels.mjs",
		"test:engine-levels": "node actions/check-engine-levels.cjs",
		"present": "parcel serve source/presentation.pug -p 909",
		"tests": "parcel serve source/tests.pug -p 606",
		"test:serve": "parcel serve source/tests.pug -p 909",
		"=UTILITIES=": "------------------------------------",
		"kill": "pnpm dlx kill-port 909",
		"clean": "node actions/clean.mjs",
		"reset": "node actions/reset.mjs",
		"hardreset": "node actions/reset.mjs --total",
		"changes": "node actions/changelog.mjs",
		"copy": "node actions/copy.mjs",
		"deps": "pnpm install --frozen-lockfile",
		"rebuild": "./node_modules/.bin/electron-rebuild.cmd",
		"node:rebuild": "electron-rebuild -f -w",
		"mobile:icons": "pnpm exec capacitor-assets generate",
		"icons": "pnpm run electron:icons && pnpm run mobile:icons",
		"analyse": "parcel build source/index.pug --profile --detailed-report",
		"push:": "git push origin --tags && git push origin",
		"rss": "node actions/rss.mjs",
		"zips": "node actions/zips.mjs",
		"upgrader": "pnpm dlx npm-check-updates --interactive --reject open-gm -u && pnpm run soundfont:upgrade",
		"=SLIDES=": "------------------------------------",
		"slides": "decktape automatic http://localhost:909/updates.html ./documentation/updates.pdf",
		"=START=": "------------------------------------",
		"freshstart": "pnpm run reset && pnpm run start",
		"start": "pnpm run serve",
		"index": "pnpm run serve:index",
		"wam": "pnpm run serve:wam",
		"soundfont:upgrade": "node actions/upgrade-soundfont.cjs",
		"assets": "turbo run copy zips streamdeck:build",
		"clear": "pnpm run clean && pnpm run copy",
		"doc": "jsdoc -d docs --configure .jsdoc.json source/interface.js",
		"=SERVE=": "------------------------------------",
		"serve": "pnpm run assets && cross-env PARCEL_WORKERS=1 parcel serve -p 909 --target dev",
		"serve:index": "parcel serve source/index.pug -p 909",
		"serve:tests": "parcel serve source/tests.pug -p 909",
		"serve:wam": "parcel serve source/tests.pug -p 909",
		"party": "pnpm exec partykit dev",
		"=BUILD=": "------------------------------------",
		"build": "pnpm run build:web",
		"report": "parcel build --reporter @parcel/reporter-bundle-analyzer source/index.pug --public-url ./ --target web",
		"build:help": "parcel build --public-url ./ source/help.pug --target web",
		"build:roadmap": "parcel build --public-url ./ source/roadmap.pug --target web",
		"build:debug": "parcel build --no-optimize --no-scope-hoist --target web",
		"build:all": "parcel build --public-url ./ source/*.pug --target web",
		"build:wam": "parcel build --no-content-hash --public-url ./ source/wam.pug --target web",
		"build:index": "parcel build --public-url ./ source/index.pug --target web",
		"build:release": "parcel build --target electron-main --target electron-renderer --target web",
		"build:web": "turbo run build:web:parcel --log-order=stream --output-logs=full",
		"build:web:parcel": "node actions/clean-web.mjs && cross-env PARCEL_WORKERS=1 parcel build --public-url ./ --target web --target service-worker && node actions/room-pages.mjs && node actions/offline.mjs",
		"=ELECTRON=": "------------------------------------",
		"electron:rebuild": "electron-rebuild -f",
		"electron:clean": "rimraf dist-electron && rimraf releases",
		"electron:icons": "electron-icon-maker --input=./source/assets/logos/interface_round.2048.png --output=./static/",
		"electron:secure": "electronegativity -i ./dist-electron/",
		"electron:test": "electron --inspect=9229  --enable-logging dist-electron/electron/main.js",
		"electron:build": "pnpm run electron:compile",
		"electron:compile": "parcel build --target electron-preload --target electron-main --config ./.parcelnocopyrc",
		"electron:renderer": "parcel build --target electron-renderer --no-content-hash",
		"electron:serve": "parcel serve --target electron-renderer --no-content-hash -p 303",
		"electron:dev": "pnpm run electron:compile && concurrently 'pnpm:electron:serve' 'pnpm:electron:test'",
		"electron:native-midi": "node actions/build-native-midi-addon.js",
		"electron:make": "pnpm run electron:clean && pnpm run electron:build && pnpm run electron:native-midi && electron-forge make",
		"electron:publish": "pnpm run electron:clean && pnpm run electron:build && pnpm run electron:native-midi && electron-forge publish",
		"build:electron-main": "parcel build --target electron-main --config ./.parcelnocopyrc",
		"build:electron-preload": "parcel build --target electron-preload --config ./.parcelnocopyrc",
		"build:electron-renderer": "parcel build --target electron-renderer --no-content-hash",
		"build:electron": "pnpm run electron:build",
		"run:electron": "electron . --enable-logging",
		"packager:electron": "electron-packager . photosynth-interface --overwrite --out=releases --icon=./source/assets/icons/icon.ico",
		"open:electron": "pnpm exec cap open @capacitor-community/electron",
		"status:electron": "electron-packager --version",
		"debug:electron": "electron --inspect",
		"make:electron": "electron-forge make",
		"electron:package": "electron-forge package",
		"=DESKTOP=": "------------------------------------",
		"desktop:start": "electron-forge start",
		"desktop:dev": "pnpm run electron:build && concurrently 'pnpm:electron:serve' 'pnpm:desktop:start'",
		"desktop:package": "electron-forge package",
		"desktop:make": "electron-forge make  --verbose",
		"desktop:publish": "electron-forge publish",
		"=ANDROID=": "------------------------------------",
		"build:android": "parcel build --public-url ./ --dist-dir ./dist --no-source-maps source/app.pug",
		"android:add": "pnpm exec cap add android",
		"android:open": "pnpm exec cap open android",
		"android:run": "pnpm exec cap run android",
		"android": "pnpm run clear && pnpm run build:android && node actions/app.mjs && pnpm run android:add && pnpm run android:open",
		"=STREAMDECK=": "------------------------------------",
		"streamdeck:build": "node actions/build-profile.mjs",
		"=LICENSES=": "------------------------------------",
		"copyrights:list": "NODE_ENV=production yarn licenses list && node license.mjs",
		"license:summary": "pnpm dlx license-checker --summary > LICENSES.md && pnpm dlx license-checker --summary > source/licenses.md",
		"license:table": "pnpm dlx license-report --output=table >> LICENSES.md  && pnpm dlx license-checker --output=table >> source/licenses.md",
		"license:smallprint": "yarn licenses generate-disclaimer >> LICENSES.md && yarn licenses generate-disclaimer >> source/licenses.md",
		"license:report": "pnpm dlx license-report --output=markdown >> LICENSES.md && pnpm dlx license-report --output=markdown >> source/licenses.md",
		"license": "pnpm run license:report && pnpm run license:smallprint && pnpm run license:table && pnpm run license:summary",
		"license:build": "parcel build --public-url ./ source/licenses.pug",
		"=REVISION=": "------------------------------------",
		"revise": "node actions/revision.mjs",
		"patch": "changelog -p && pnpm version patch --no-git-tag-version && pnpm run revise",
		"minor": "changelog -m && pnpm version minor --no-git-tag-version && pnpm run revise",
		"major": "changelog -M && pnpm version major --no-git-tag-version && pnpm run revise",
		"=RELEASE=": "------------------------------------",
		"package": "pnpm run minor && pnpm run clear && pnpm run build",
		"release:patch": "pnpm run patch && pnpm run build:all",
		"release:minor": "pnpm run minor && pnpm run build:all",
		"release:major": "pnpm run major && pnpm run build:all",
		"release:app": "pnpm run patch && pnpm run assets && pnpm run push",
		"release": "pnpm run changes && pnpm run rss && pnpm run build",
		"deploy": "pnpm exec partykit deploy",
		"=QUALITY=": "",
		"knip": "knip",
		"help": "pnpm dlx https://github.com/google-gemini/gemini-cli"
	},
	"staticFiles": [
		{
			"staticPath": "static"
		},
		{
			"staticPath": "./node_modules/open-gm/OpenGM24",
			"staticOutPath": "assets/audio/OpenGM24/"
		},
		{
			"staticPath": "./node_modules/open-gm/OpenGM24.json",
			"staticOutPath": "assets/audio/"
		},
		{
			"staticPath": "./node_modules/open-gm/LICENSE.txt",
			"staticOutPath": "assets/audio/OpenGM24/"
		},
		{
			"staticPath": "./node_modules/@tensorflow/tfjs-backend-webgpu/dist",
